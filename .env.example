# Amazon affiliate links are ON by default. Set to false to hide them.
PUBLIC_AFFILIATE_ENABLED=true

# AdSense ad slots stay OFF unless explicitly set to true (account not approved).
PUBLIC_ADS_ENABLED=false

# Pay-per-lead tracking link for the "Get painter quotes" button (Networx, Angi, Modernize, etc.).
# Leave empty to send visitors to the email signup form instead.
PUBLIC_PAINTER_LEAD_URL=
