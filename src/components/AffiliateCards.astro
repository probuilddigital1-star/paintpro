---
// Affiliate product cards. Defaults come from the central catalog in src/data/products.ts.
import type { AffiliateProduct } from '../data/calculator-pages';
import { affiliateEnabled } from '../config/site';
import { products } from '../data/products';

interface Props {
  products?: AffiliateProduct[];
  pageSource?: string;
}

const { products: overrides, pageSource } = Astro.props;

const defaultProducts: AffiliateProduct[] = (['supplies-kit', 'interior-paint', 'sprayer'] as const).map((id) => ({
  title: products[id].title,
  description: products[id].description,
  icon: products[id].icon,
  link: products[id].url,
  cta: products[id].cta,
}));

const affiliates = overrides ?? defaultProducts;
---

{affiliateEnabled && <section id="affiliate-section" class="max-w-4xl mx-auto px-4 py-12 md:py-16">
  <div class="mb-8 max-w-2xl">
    <h2 class="text-[1.875rem] md:text-[2.5rem] text-heading">Ready to Start Your Project?</h2>
    <p class="mt-3 text-body">Everything you need to get professional results.</p>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    {affiliates.map((item) => (
      <a
        href={item.link}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="supply-card panel flex flex-col p-5 md:p-6"
        data-affiliate-product={item.title}
        data-affiliate-link={item.link}
        data-page-source={pageSource ?? 'default'}
        data-affiliate-card
      >
        <h3 class="text-lg/snug text-heading">
          {item.title}
        </h3>
        <p class="mt-2 flex-grow text-[0.9375rem] text-body">
          {item.description}
        </p>

        <span class="supply-cta mt-4 self-start text-[0.9375rem] font-semibold">
          {item.cta}
        </span>
      </a>
    ))}
  </div>

  <p class="mt-5 text-[0.8125rem] text-muted">
    Product links go to Amazon.com
  </p>
</section>}

<style>
  .supply-card {
    transition: border-color 150ms ease;
  }

  .supply-card:hover {
    border-color: var(--color-heading);
  }

  .supply-cta {
    color: var(--color-primary);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .supply-card:hover .supply-cta {
    color: var(--color-primary-dark);
    text-decoration-thickness: 2px;
  }
</style>

{affiliateEnabled && <script>
  import { trackAffiliateClick } from '../utils/analytics';

  // Scoped to this component's own cards. The calculator result blocks carry
  // data-affiliate-product too and bind their own handlers, so a broad selector
  // here would double-count those clicks in GA4.
  document.querySelectorAll<HTMLAnchorElement>('[data-affiliate-card]').forEach((link) => {
    link.addEventListener('click', () => {
      trackAffiliateClick({
        product: link.dataset.affiliateProduct,
        link: link.dataset.affiliateLink,
        pageSource: link.dataset.pageSource,
      });
    });
  });
</script>}
