---
interface BreadcrumbItem {
  name: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="max-w-4xl mx-auto px-4 pt-4 pb-2">
  <ol class="text-sm text-muted">
    {items.map((item) => (
      <li class="crumb inline">
        {item.href ? (
          <a href={item.href} class="crumb-link">{item.name}</a>
        ) : (
          <span class="text-heading" aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  /* A plain slash between items, drawn in CSS so screen readers skip it. */
  .crumb + .crumb::before {
    content: "/";
    content: "/" / "";
    margin-inline: 0.5rem;
    color: var(--color-border-strong);
  }

  .crumb-link {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .crumb-link:hover {
    color: var(--color-heading);
    text-decoration-color: currentColor;
  }
</style>
