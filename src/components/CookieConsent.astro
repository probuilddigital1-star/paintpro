---
// Cookie Opt-Out Banner - CCPA compliant (opt-out model)
// GA4 loads by default; users can opt out via footer link.
// AdSense only loads when ads are enabled.
import { adsEnabled } from '../config/site';
---

<div id="cookie-banner" class="cookie-bar fixed bottom-0 left-0 right-0 z-50 hidden bg-heading text-on-ink">
  <div class="mx-auto flex max-w-4xl flex-col gap-4 px-4 pt-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
    <div class="min-w-0">
      <h3 class="text-base text-on-ink">Cookie Settings</h3>
      <p class="mt-1 text-sm text-on-ink-muted">
        We use cookies for analytics and advertising to improve your experience.
        <a href="/privacy" class="cookie-link">Learn more</a>
      </p>
    </div>

    <div class="flex shrink-0 gap-3">
      <button id="cookie-optout" type="button" class="btn btn-on-ink btn-sm">
        Opt out
      </button>
      <button id="cookie-close" type="button" class="btn btn-primary btn-sm">
        Got it
      </button>
    </div>
  </div>
</div>

<style>
  /* Clear the home indicator on phones that have one. */
  .cookie-bar > div {
    padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
  }

  .cookie-link {
    color: var(--color-on-ink);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .cookie-link:hover {
    text-decoration-thickness: 2px;
  }

  /* The terracotta focus ring is only about 3:1 on ink, so use linen here. */
  .cookie-bar :focus-visible {
    outline-color: var(--color-on-ink);
  }
</style>

<script is:inline define:vars={{ adsEnabled }}>
  (function() {
    const CONSENT_KEY = 'cookie_consent';
    const banner = document.getElementById('cookie-banner');
    const closeBtn = document.getElementById('cookie-close');
    const optoutBtn = document.getElementById('cookie-optout');

    var consent = localStorage.getItem(CONSENT_KEY);

    if (consent === 'opted_out') {
      // User opted out - do not load tracking
      return;
    }

    // Load GA4 and AdSense by default for all users
    loadTracking();

    closeBtn.addEventListener('click', function() {
      localStorage.setItem(CONSENT_KEY, 'accepted');
      banner.classList.add('hidden');
    });

    optoutBtn.addEventListener('click', function() {
      localStorage.setItem(CONSENT_KEY, 'opted_out');
      banner.classList.add('hidden');
      disableTracking();
    });

    function loadTracking() {
      // Only load in production. Cloudflare Pages preview deployments (*.pages.dev) are skipped
      // too, so previews never count in the production GA4 property.
      var host = window.location.hostname;
      if (host === 'localhost' || host === '127.0.0.1' || host.endsWith('.pages.dev')) return;

      // Check if already loaded
      if (window.gtag) return;

      // Load GA4 script
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-C766XS9QKY';
      document.head.appendChild(script);

      script.onload = function() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-C766XS9QKY');
      };

      // Load AdSense script only when ads are enabled
      if (adsEnabled && !document.querySelector('script[src*="adsbygoogle"]')) {
        var adsScript = document.createElement('script');
        adsScript.async = true;
        adsScript.crossOrigin = 'anonymous';
        adsScript.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7820884299125377';
        document.head.appendChild(adsScript);
      }
    }

    function disableTracking() {
      // Disable GA4
      window['ga-disable-G-C766XS9QKY'] = true;

      // Remove tracking cookies
      document.cookie.split(';').forEach(function(c) {
        var name = c.trim().split('=')[0];
        if (name.startsWith('_ga') || name.startsWith('_gid')) {
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=' + window.location.hostname;
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
        }
      });
    }

    // Expose function to open settings (for footer link)
    window.openCookieSettings = function() {
      banner.classList.remove('hidden');
    };
  })();
</script>
