---
// Header component - Polished navigation with glass effect
---

<header class="bg-white/80 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-slate-100">
  <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group" aria-label="PaintPro Calculator - Home">
      <!-- Paint bucket icon with gradient -->
      <div class="relative">
        <div class="w-10 h-10 bg-gradient-to-br from-primary to-primary-dark rounded-xl flex items-center justify-center shadow-lg shadow-primary/25 group-hover:shadow-primary/40 transition-shadow">
          <svg
            class="w-5 h-5 text-white"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"/>
            <path d="M7 17h10c.55 0 1-.45 1-1v-4c0-.55-.45-1-1-1H7c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1zm1-4h8v2H8v-2z"/>
            <path d="M17 7H7v2h10V7z"/>
          </svg>
        </div>
        <!-- Decorative dot -->
        <div class="absolute -top-1 -right-1 w-3 h-3 bg-accent rounded-full border-2 border-white"></div>
      </div>
      <div>
        <span class="text-xl font-bold text-heading">PaintPro</span>
        <span class="text-xl font-bold text-gradient">Calculator</span>
      </div>
    </a>

    <div class="hidden sm:flex items-center gap-4">
      <p class="text-sm text-body">Know exactly how much paint you need</p>
      <a
        href="#calculator"
        class="text-sm font-medium text-primary hover:text-primary-dark transition-colors flex items-center gap-1"
      >
        Try it free
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</header>
