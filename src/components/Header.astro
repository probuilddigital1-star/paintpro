---
// Site header: serif wordmark, plain text nav, the current section marked with a terracotta
// underline. Phones get the wordmark on one row and all four links on a single row below it
// (the full wordmark and four links need about 395px, more than a 360px screen has).
//
// build.format is 'file', so Astro.url.pathname ends in .html (and /index.html at the root).
const path =
  Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const inSection = (base: string) => path === base || path.startsWith(`${base}/`);

// aria-current is "page" when the link is this page, "true" when it is the section this page sits in.
const links = [
  {
    href: '/#calculator',
    label: 'Calculator',
    current: path === '/' ? 'page' : inSection('/paint-calculator') ? 'true' : undefined,
  },
  { href: '/paint-planner', label: 'Planner', current: path === '/paint-planner' ? 'page' : undefined },
  { href: '/blog', label: 'Guides', current: path === '/blog' ? 'page' : inSection('/blog') ? 'true' : undefined },
  {
    href: '/hire-a-painter?src=nav',
    label: 'Find a Painter',
    current: path === '/hire-a-painter' ? 'page' : undefined,
  },
  { href: '/about', label: 'About', current: path === '/about' ? 'page' : undefined, wide: true },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-secondary">
  <div class="mx-auto flex max-w-4xl flex-col px-4 pt-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:py-4">
    <a href="/" class="logo self-start text-heading" aria-label="PaintPro Calculator - Home">
      <span>PaintPro</span>
      <span>Calculator</span>
    </a>

    <nav class="flex max-w-[21rem] items-baseline justify-between sm:max-w-none sm:justify-end sm:gap-x-5 md:gap-x-7 lg:gap-x-9" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link whitespace-nowrap', link.wide && 'hidden sm:inline']}
          aria-current={link.current}
        >{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .logo {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-link {
    /* The vertical padding makes a taller tap target without making the header taller. */
    padding-block: 0.625rem;
    color: var(--color-body);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    text-underline-offset: 6px;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .nav-link:hover {
    color: var(--color-heading);
    text-decoration-color: var(--color-border-strong);
  }

  .nav-link[aria-current] {
    color: var(--color-heading);
    text-decoration-color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .logo {
      font-size: 1.625rem;
    }

    .nav-link {
      padding-block: 0.375rem;
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 1024px) {
    .logo {
      font-size: 1.75rem;
    }
  }
</style>
