---
// Homepage hero, "Linen" direction 1a: the H1 and intro on the left, a quiet drawing of paint
// chips on the right. There is no photo. The chips are plain CSS so nothing extra downloads.
// Their names are made up and drawn from data-name with CSS, so they stay out of the page text
// that search engines and screen readers read; the whole drawing is aria-hidden.
const chips = [
  { name: 'Washed Linen', color: 'oklch(0.88 0.022 72)' },
  { name: 'Terracotta', color: 'var(--color-accent)' },
  { name: 'Deep Olive', color: 'oklch(0.43 0.045 108)' },
  { name: 'Soft Clay', color: 'oklch(0.74 0.06 48)' },
];
---

<section class="hero">
  <div class="mx-auto grid max-w-4xl gap-8 px-4 pt-9 pb-6 md:grid-cols-[1.05fr_1fr] md:items-end md:gap-12 md:pt-16 md:pb-16 lg:pt-18">
    <div class="flex flex-col gap-6 md:gap-7">
      <h1 class="hero-title">Calculate Your Paint Like a Pro</h1>

      <p class="hero-intro">
        Estimate paint for walls, ceilings, and trim. Adjust for openings, texture, primer, and extra coats.
      </p>

      <div class="flex flex-col items-start gap-4">
        <a href="#calculator" class="btn btn-primary">Start Calculating</a>
        <p class="hero-note">
          Free, no signup required. Professional accuracy, texture adjustments, and primer estimates.
        </p>
      </div>
    </div>

    <div class="chips" aria-hidden="true">
      {chips.map((chip, i) => (
        <div class={`chip chip-${i + 1}`} style={`--chip: ${chip.color}`} data-name={chip.name}>
          <span class="chip-color"></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-title {
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-intro {
    max-width: 30rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-body);
  }

  .hero-note {
    max-width: 26rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* Paint chips laid on a table: the color runs to the edges and the name is printed on the
     paper strip below it, like the chips at a paint counter. The chips sit high and low in
     turn, so no chip covers another chip's name. On phones they shrink to a short row so the
     calculator still shows on the first screen. */
  .chips {
    position: relative;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 22 / 8;
  }

  .chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 27%;
    overflow: hidden;
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    box-shadow: 0 1px 2px rgb(60 40 20 / 0.06), 0 6px 14px rgb(60 40 20 / 0.06);
    transform: rotate(var(--r));
  }

  .chip-color {
    display: block;
    aspect-ratio: 1 / 0.8;
    background-color: var(--chip);
  }

  .chip::after {
    content: attr(data-name);
    display: block;
    padding: 5px 7px 6px;
    font-size: 0.6875rem;
    line-height: 1.2;
    color: var(--color-heading);
    white-space: nowrap;
  }

  .chip-1 { --x: 0%;    --y: 15%; --r: -4deg; }
  .chip-2 { --x: 24%;   --y: 3%;  --r: 1deg; }
  .chip-3 { --x: 48.5%; --y: 13%; --r: -1.5deg; }
  .chip-4 { --x: 72%;   --y: 4%;  --r: 3.5deg; }

  @media (min-width: 768px) {
    .chips {
      max-width: none;
      aspect-ratio: 11 / 9;
    }

    .chip {
      width: 41%;
    }

    .chip-color {
      aspect-ratio: 1 / 1.05;
    }

    .chip::after {
      padding: 8px 9px 10px;
    }

    .chip-1 { --x: 0%;    --y: 27%; --r: -5deg; }
    .chip-2 { --x: 19.5%; --y: 8%;  --r: 1.5deg; }
    .chip-3 { --x: 39%;   --y: 25%; --r: -2deg; }
    .chip-4 { --x: 58.5%; --y: 7%;  --r: 4.5deg; }

    .hero-title {
      font-size: 3.75rem;
    }

    .hero-intro {
      font-size: 1.1875rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 4.75rem;
    }

    .chip::after {
      padding: 9px 11px 11px;
      font-size: 0.75rem;
    }
  }
</style>
