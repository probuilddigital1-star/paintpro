---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;
---

{faqs.length > 0 && (
  <section class="max-w-4xl mx-auto px-4 py-10 md:py-14">
    <h2 class="mb-6 text-[1.875rem] md:text-[2.5rem] text-heading">Frequently Asked Questions</h2>
    <div class="border-t border-border">
      {faqs.map((faq) => (
        <details class="group border-b border-border">
          <summary class="group/q flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
            <h3 class="text-lg/snug md:text-xl/snug text-heading transition-colors group-hover/q:text-primary">{faq.question}</h3>
            <svg class="mt-1 md:mt-1.5 size-4 shrink-0 text-heading" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M2 8h12" />
              <path class="origin-center transition-transform duration-200 [transform-box:fill-box] group-open:rotate-90 motion-reduce:transition-none" d="M8 2v12" />
            </svg>
          </summary>
          <p class="max-w-[68ch] pb-6 pr-10 text-body">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
