---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;
---

{faqs.length > 0 && (
  <section class="max-w-4xl mx-auto px-4 py-10 md:py-14">
    <h2 class="mb-6 text-[1.875rem] md:text-[2.5rem] text-heading">Frequently Asked Questions</h2>
    <div class="border-t border-border">
      {faqs.map((faq) => (
        <details class="disclosure border-b border-border">
          <summary class="group/q gap-6 py-5 text-lg/snug md:text-xl/snug">
            <h3 class="text-lg/snug md:text-xl/snug text-heading transition-colors group-hover/q:text-primary">{faq.question}</h3>
          </summary>
          <p class="max-w-[68ch] pb-6 pr-10 text-body">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
