---
// Painter quote call to action. Every instance is a plain link to /hire-a-painter with a
// placement tag in the query string, which that page reads for the quote_page_view event.
// No script, no third-party code: the Networx embed lives only on /hire-a-painter.
//
// Variants:
//   card   - ink panel with heading, one line of body text, and a terracotta button, so it
//            reads as a service prompt, not another product tile. It goes side by side when
//            the card itself is at least 32rem wide (a container query), so it also fits
//            narrow sidebars like the planner's.
//   inline - one sentence for use mid-article, with the second sentence as the button.
//            Defaults: "Thinking about hiring this out?" + "Get quotes from local painters."
interface Props {
  /** Placement tag, appended as ?src=... (letters, digits, dash, underscore). */
  src: string;
  variant?: 'card' | 'inline';
  heading?: string;
  body?: string;
  buttonText?: string;
}

const {
  src,
  variant = 'card',
  heading = 'Want a pro to handle it?',
  body,
  buttonText,
} = Astro.props;

if (!/^[A-Za-z0-9_-]+$/.test(src)) {
  throw new Error(`PainterQuoteCTA: src "${src}" must contain only letters, digits, dashes, or underscores.`);
}

const href = `/hire-a-painter?src=${src}`;
const isInline = variant === 'inline';

const bodyText = body ?? (isInline
  ? 'Thinking about hiring this out?'
  : 'Tell us about the project and get quotes from local painters.');
const button = buttonText ?? (isInline ? 'Get quotes from local painters.' : 'Get painter quotes');
---

{isInline ? (
  <p class="flex flex-wrap items-center gap-x-4 gap-y-3 text-body" data-painter-cta={src}>
    <span>{bodyText}</span>
    <a href={href} class="quote-btn btn btn-primary btn-sm">{button}</a>
  </p>
) : (
  <div class="quote-card panel-ink @container" data-painter-cta={src}>
    <div class="flex flex-col gap-5 px-6 py-7 @lg:flex-row @lg:items-center @lg:justify-between @lg:gap-8 @lg:px-8">
      <div class="min-w-0">
        <p class="quote-heading">{heading}</p>
        <p class="mt-2 text-[0.9375rem] text-on-ink-muted">{bodyText}</p>
      </div>
      <a href={href} class="quote-btn btn btn-primary shrink-0 whitespace-nowrap">{button}</a>
    </div>
  </div>
)}

<style>
  .quote-heading {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--color-on-ink);
  }

  /* Keep the button a button even when a page drops this inside article styles that
     color and underline every link. */
  a.quote-btn,
  a.quote-btn:hover {
    color: var(--color-on-accent);
    text-decoration: none;
  }

  /* The terracotta focus ring is only about 3:1 on ink, so use linen inside the card. */
  .quote-card :focus-visible {
    outline-color: var(--color-on-ink);
  }
</style>
