---
import { calculatorPages } from '../data/calculator-pages';
import { indexableCalculatorSlugs } from '../config/indexing';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
const pages = slugs
  .map(slug => calculatorPages.find(p => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined && indexableCalculatorSlugs.has(p.slug));
---

{pages.length > 0 && (
  <section class="max-w-4xl mx-auto px-4 py-10 md:py-14">
    <h2 class="mb-6 text-[1.875rem] md:text-[2.5rem] text-heading">Related Calculators</h2>
    <ul class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
      {pages.map(page => (
        <li class="border-t border-border">
          <a href={`/paint-calculator/${page.slug}`} class="group block pt-4 pb-6">
            <h3 class="related-title text-lg/snug text-heading">{page.h1}</h3>
            <p class="mt-1.5 text-sm text-muted line-clamp-2">{page.metaDescription.slice(0, 80)}...</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  /* The rule above each item already marks the list, so the title stays plain until hover. */
  .related-title {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  a:hover .related-title {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }
</style>
