---
// The calculator-page result. It uses the same markup and classes as the homepage calculator's
// result (Calculator.astro); the estimate, receipt and breakdown styles live in global.css, so
// the two always look the same.
import type { CalculationResults, CalculationInputs } from '../utils/paint-calculator';
import { estimateProCost, proCostJob, roomRecommendations } from '../utils/paint-calculator';
import { proCostNoteParts, proCostScopeFor } from '../utils/pro-cost-note';
import { recommendProducts } from '../utils/product-recommendations';
import { affiliateEnabled } from '../config/site';

interface Props {
  results: CalculationResults;
  inputs: CalculationInputs;
  /** Brand display name on a `*-coverage` page, so the brand's own paint is recommended. */
  brand?: string;
  /** Slug used as the analytics page source. */
  pageSource?: string;
  /** What the preset paints, for the receipt subline ("garage", "dining room"). Defaults to "room". */
  roomLabel?: string;
}

const { results, inputs, brand, pageSource, roomLabel = 'room' } = Astro.props;

const totalArea = Math.round(results.paintableArea + results.ceilingPaintableArea);
const recommendation = roomRecommendations[inputs.roomType];
const recs = affiliateEnabled ? recommendProducts(inputs, results, { brand }) : [];
const source = pageSource ?? 'calculator-static';

// Hiring-a-painter range for the line above the painter quote card, worked out at build time.
const proJob = proCostJob(inputs, results);
const proRange = proJob ? estimateProCost(proJob) : null;
const proNote = proRange ? proCostNoteParts(proRange, proCostScopeFor(inputs.surfaceType)) : null;

// The answer in whole gallons, the range around it, and the receipt subline.
const range = results.estimateRange;
const purchaseGallons = range.likely.purchaseGallons;
const rangePoints = [
  { label: 'Low', value: range.low.gallonsWithWaste, likely: false },
  { label: 'Likely', value: range.likely.gallonsWithWaste, likely: true },
  { label: 'High', value: range.high.gallonsWithWaste, likely: false },
];
const receiptSub = `${inputs.length}x${inputs.width} ft ${roomLabel}, ${inputs.numCoats} ${inputs.numCoats === 1 ? 'coat' : 'coats'}`;

// The receipt total follows the job, as on the homepage calculator: the net wall area for walls,
// both together for walls and ceiling, the ceiling alone for a ceiling job, and no total for trim.
const receiptArea = {
  walls: { label: 'Wall area', area: results.paintableArea },
  'walls-ceiling': { label: 'Wall and ceiling area', area: results.paintableArea + results.ceilingPaintableArea },
  ceiling: { label: 'Ceiling area', area: results.ceilingPaintableArea },
  trim: null,
}[inputs.surfaceType];
---

<section class="mx-auto max-w-4xl px-4 pt-10 pb-4 md:pt-14" aria-labelledby="static-estimate-title">
  <h2 id="static-estimate-title" class="text-[1.875rem] md:text-[2.5rem]">Pre-Calculated Paint Estimate</h2>

  <div class="estimate mt-8 md:mt-10">
    <!-- The answer: whole gallons to buy, the range around it, and how it was worked out. -->
    <div class="estimate-figure">
      <p class="estimate-number">{purchaseGallons}</p>
      <p class="estimate-unit">{purchaseGallons === 1 ? 'gallon' : 'gallons'}</p>

      <div class="estimate-range" role="group" aria-label="Estimated paint range">
        {rangePoints.map((point) => (
          <div class:list={[{ 'is-likely': point.likely }]}>
            <span class="estimate-range-label">{point.label}</span>
            <span class="estimate-range-value">{point.value.toFixed(1)} <span class="estimate-range-unit">gal</span></span>
          </div>
        ))}
      </div>

      <p class="estimate-summary">
        This range covers {totalArea} square feet with {inputs.numCoats} coats. The likely estimate is {range.likely.rawGallons.toFixed(2)} gallons before the selected buffer. If you are buying whole gallons, plan on {purchaseGallons}.
      </p>

      {results.primerGallons > 0 && (
        <div class="estimate-primer">
          <span class="estimate-range-label">Primer Needed</span>
          <span class="estimate-range-value">{results.primerGallons} <span class="estimate-range-unit">{results.primerGallons === 1 ? 'gallon' : 'gallons'}</span></span>
        </div>
      )}

      <details class="breakdown disclosure">
        <summary>
          View Detailed Breakdown
        </summary>
        <div class="breakdown-rows">
          <div class="breakdown-row"><span>Wall Area:</span><span>{Math.round(results.wallArea)} sq ft</span></div>
          {results.includesCeiling && (
            <div class="breakdown-row"><span>Ceiling Area:</span><span>{Math.round(results.ceilingArea)} sq ft</span></div>
          )}
          <div class="breakdown-row"><span>Deductions:</span><span>-{Math.round(results.totalDeduction)} sq ft</span></div>
          <hr />
          <div class="breakdown-row is-total"><span>Net Paintable Area:</span><span>{totalArea} sq ft</span></div>
          <div class="breakdown-row"><span>Base Coverage Rate:</span><span>{results.baseCoverage} sq ft/gal</span></div>
          <div class="breakdown-row"><span>Adjusted Coverage:</span><span>{Math.round(results.adjustedWallCoverage)} sq ft/gal</span></div>
          <div class="breakdown-row"><span>With {inputs.numCoats} Coats:</span><span>{Math.round(results.wallCoverageNeeded + results.ceilingCoverageNeeded)} sq ft needed</span></div>
          {inputs.includeWaste && (
            <div class="breakdown-row"><span>+ 15% Waste Buffer:</span><span>+{results.wasteAmount.toFixed(2)} gal</span></div>
          )}
          {results.primerGallons > 0 && (
            <>
              <hr />
              <div class="breakdown-row"><span>Primer ({inputs.primerCoats ?? 1} coat):</span><span>{results.primerGallons} gal</span></div>
            </>
          )}
        </div>
      </details>

      <p class="mt-4 text-[0.8125rem] leading-normal text-muted">
        Based on a {inputs.length}x{inputs.width} ft room with {inputs.height}-ft ceilings, {inputs.doors + inputs.closetDoors + inputs.frenchDoors} door(s), and {inputs.windows + inputs.largeWindows + inputs.smallWindows} window(s). Paint at {results.baseCoverage} sq ft/gallon{inputs.includeWaste ? ' with a 15% buffer' : ' without a waste buffer'}.
      </p>
      <p class="mt-2">
        <a href="/calculator-methodology" class="link text-[0.9375rem]">See the formula and assumptions</a>
      </p>
    </div>

    <!-- The shopping list. Every supply keeps its Amazon link, rel, data attributes and click tracking. -->
    <div class="receipt">
      <span class="receipt-tape" aria-hidden="true"></span>
      <div class="receipt-head">
        <p class="receipt-title">Your paint run</p>
        <p class="receipt-sub">{receiptSub}</p>
      </div>

      <hr class="receipt-rule" />

      <div class="receipt-row"><span>Paint</span><span>{purchaseGallons} gal</span></div>
      {results.primerGallons > 0 && (
        <div class="receipt-row"><span>Primer</span><span>{results.primerGallons} gal</span></div>
      )}

      {recs.length > 0 && (
        <>
          <hr class="receipt-rule" />
          <h3 class="receipt-heading">Supplies for this room</h3>
          <ul class="receipt-supplies">
            {recs.map(({ product, reason }) => (
              <li class="receipt-row">
                <a
                  href={product.url}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  class="receipt-supply"
                  data-affiliate-product={product.id}
                  data-affiliate-link={product.url}
                  data-page-source={source}
                  data-static-affiliate
                >
                  <span class="receipt-supply-name">{product.title}</span>
                  <span class="receipt-supply-note">{reason} <span class="receipt-supply-cta">{product.cta}</span></span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}

      {receiptArea && (
        <>
          <hr class="receipt-rule" />

          <div class="receipt-total">
            <span>{receiptArea.label}</span>
            <span class="receipt-total-value">{Math.round(receiptArea.area)} sq ft</span>
          </div>
        </>
      )}

      {recs.length > 0 && (
        <p class="receipt-note">
          Picked from the inputs above. Links go to Amazon and we may earn a commission at no extra cost to you.
          <a href="/affiliate-disclosure">Details</a>
        </p>
      )}
    </div>

    <!-- Hiring line and the painter quote card (the room pages pass the card in this slot). In the
         estimate grid: under the number beside the receipt on desktop, after the receipt on phones. -->
    {Astro.slots.has('after-estimate') && (
      <div class="estimate-hire">
        {proNote && (
          <p class="hire-line mb-4 max-w-[36rem]">{proNote.text}<a href={proNote.href} class={proNote.linkClass}>{proNote.linkText}</a></p>
        )}
        <slot name="after-estimate" />
      </div>
    )}
  </div>

  <!-- The room tip, as a quiet note after the card, across the full width of the result. -->
  {recommendation && (
    <p class="callout mt-10 text-[0.9375rem] leading-relaxed md:mt-12">{recommendation}</p>
  )}
</section>

<script>
  import { trackAffiliateClick } from '../utils/analytics';

  document.querySelectorAll<HTMLAnchorElement>('[data-static-affiliate]').forEach((link) => {
    link.addEventListener('click', () => {
      trackAffiliateClick({
        product: link.dataset.affiliateProduct,
        link: link.dataset.affiliateLink,
        pageSource: link.dataset.pageSource,
      });
    });
  });
</script>
