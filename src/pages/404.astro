---
// Without this page, Cloudflare Pages answers every missing URL with the
// homepage and a 200 status. Google treats that as a soft 404 and can index
// junk URLs. Astro builds this to 404.html, which Pages serves with a real
// 404 status.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const popular = [
  { href: '/', label: 'Paint calculator', note: 'Estimate gallons for any room' },
  { href: '/paint-calculator/garage-paint-calculator', label: 'Garage paint calculator', note: 'Walls, ceiling, and floor' },
  { href: '/paint-calculator/behr-coverage', label: 'How much Behr paint do I need?', note: 'Coverage by product line' },
  { href: '/paint-planner', label: 'Project planner', note: 'Total a whole house, room by room' },
  { href: '/blog', label: 'Painting guides', note: 'Prep, coats, finishes, and cost' },
];

// The first link is the main way back, so it becomes the button. The rest are plain text links.
const [primary, ...others] = popular;
---

<Layout
  title="Page Not Found | PaintPro Calculator"
  description="That page does not exist. Use the paint calculator or browse the painting guides."
  indexable={false}
>
  <Header />

  <main class="mx-auto max-w-xl px-4 pt-10 pb-20 md:pt-20">
    <h1 class="mb-4 text-[2.5rem] md:text-[3.75rem]">That page does not exist</h1>
    <p class="mb-8 text-[1.0625rem] leading-relaxed md:text-[1.1875rem]">
      The link may be out of date or slightly mistyped. Here is where most people are headed.
    </p>

    <div class="mb-10 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href={primary.href} class="btn btn-primary">{primary.label}</a>
      <span class="text-sm text-muted">{primary.note}</span>
    </div>

    <ul class="border-t border-border">
      {others.map((item) => (
        <li class="border-b border-border py-4">
          <a href={item.href} class="link">{item.label}</a>
          <span class="mt-0.5 block text-sm text-muted">{item.note}</span>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>
