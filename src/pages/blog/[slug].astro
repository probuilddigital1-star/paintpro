---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateCards from '../../components/AffiliateCards.astro';
import { blogPosts, type BlogPost } from '../../data/blog-posts';
import { prepareArticleHtml } from '../../config/site';
import { indexableBlogSlugs } from '../../config/indexing';
import { editorialSources } from '../../data/editorial-sources';

export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const siteUrl = 'https://paintprocalculator.com';
const pageUrl = `${siteUrl}/blog/${post.slug}`;
const articleContent = prepareArticleHtml(post.content);
const indexable = indexableBlogSlugs.has(post.slug);
const sources = editorialSources[post.slug] ?? [];

const relatedPosts = post.relatedSlugs
  .map(slug => blogPosts.find(p => p.slug === slug))
  .filter((p): p is BlogPost => p !== undefined && indexableBlogSlugs.has(p.slug));

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": `${siteUrl}/blog`,
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": pageUrl,
    },
  ],
};

// BlogPosting schema
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.metaDescription,
  "url": pageUrl,
  "datePublished": post.publishedDate,
  "dateModified": post.updatedDate,
  "author": {
    "@type": "Person",
    "name": "Zack Pearson",
    "url": `${siteUrl}/about`,
    "jobTitle": "Founder, PaintPro Calculator",
    "worksFor": {
      "@type": "Organization",
      "name": "ProBuild Digital LLC",
      "url": "https://probuilddigital.com",
    },
  },
  "publisher": {
    "@type": "Organization",
    "name": "ProBuild Digital LLC",
    "url": "https://probuilddigital.com",
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl,
  },
  "inLanguage": "en-US",
  "wordCount": post.content.split(/\s+/).length,
  "citation": sources.map(source => source.url),
};

// FAQ schema
const faqSchema = post.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
      "author": {
        "@type": "Person",
        "name": "Zack Pearson",
        "url": `${siteUrl}/about`,
      },
      "dateModified": post.updatedDate,
    },
  })),
  "lastReviewed": post.updatedDate,
  "reviewedBy": {
    "@type": "Person",
    "name": "Zack Pearson",
    "url": `${siteUrl}/about`,
  },
} : null;

// Category badge colors
const categoryColors: Record<string, string> = {
  'Cost Guide': 'bg-green-100 text-green-800',
  'Paint Guide': 'bg-blue-100 text-blue-800',
  'Painting Tips': 'bg-amber-100 text-amber-800',
  'Brand Comparison': 'bg-purple-100 text-purple-800',
  'How-To Guide': 'bg-rose-100 text-rose-800',
};

const badgeColor = categoryColors[post.category] || 'bg-gray-100 text-gray-800';
---

<Layout title={post.title} description={post.metaDescription} indexable={indexable}>
  <Header />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Blog', href: '/blog' },
    { name: post.title },
  ]} />

  <article class="max-w-3xl mx-auto px-4 py-8">
    <!-- Article Header -->
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full ${badgeColor}`}>{post.category}</span>
        <time class="text-sm text-gray-500" datetime={post.publishedDate}>
          {new Date(post.publishedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        <span class="text-sm text-gray-400">{post.readingTime} min read</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-heading leading-tight mb-5">{post.title}</h1>

      <!-- Byline -->
      <div class="flex items-center gap-3 pt-4 border-t border-border">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-primary-dark flex items-center justify-center text-white font-bold text-sm shadow-sm flex-shrink-0">
          ZP
        </div>
        <div class="text-sm">
          <div class="text-heading">
            By <a href="/about" class="font-semibold hover:text-primary transition-colors">Zack Pearson</a>
          </div>
          <div class="text-gray-500 text-xs">
            Founder, PaintPro Calculator
            <span class="mx-1.5">·</span>
            Last updated <time datetime={post.updatedDate}>{new Date(post.updatedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
          </div>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div class="blog-prose" set:html={articleContent} />

    <aside class="mt-8 rounded-lg border border-border bg-slate-50 p-4 text-sm text-body">
      Product instructions change. For coverage, drying time, temperature limits, and surface preparation, use the current label or technical data sheet for the product in your hand. <a href="/editorial-standards" class="text-primary hover:underline">Read how these guides are checked</a>.
    </aside>

    {sources.length > 0 && (
      <section class="mt-8 rounded-2xl border border-border bg-white p-5 md:p-6" aria-labelledby="sources-heading">
        <h2 id="sources-heading" class="text-xl font-bold text-heading">Sources checked</h2>
        <p class="mt-2 text-sm leading-relaxed text-body">
          These primary references are used to check technical and safety guidance. The label and technical data sheet for the paint you buy should decide product-specific timing and application limits.
        </p>
        <ul class="mt-4 space-y-4">
          {sources.map(source => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:underline">
                {source.title}
              </a>
              <p class="mt-1 text-xs font-medium uppercase tracking-wide text-gray-500">{source.publisher}</p>
              <p class="mt-1 text-sm text-body">{source.note}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Mid-article CTA -->
    <div class="my-10 bg-gradient-to-r from-primary/5 to-accent/5 border border-primary/20 rounded-xl p-6 text-center">
      <p class="font-semibold text-heading mb-2">{post.calculatorCta.text}</p>
      <p class="text-sm text-body mb-4">Enter your room measurements to get a practical starting estimate.</p>
      <a
        href={post.calculatorCta.href}
        class="inline-block bg-accent hover:bg-accent-dark text-white font-semibold py-2.5 px-6 rounded-lg transition-all shadow-md hover:shadow-lg"
      >
        Try the Calculator
      </a>
    </div>

    <div class="max-w-3xl mx-auto"><AdSlot format="horizontal" /></div>
  </article>

  <!-- Affiliate Cards -->
  <AffiliateCards products={post.affiliateProducts} pageSource={`blog-${post.slug}`} />

  <article class="max-w-3xl mx-auto px-4">
    <!-- FAQ Section -->
    {post.faqs.length > 0 && (
      <section class="mt-12 mb-8">
        <h2 class="text-2xl font-bold text-heading mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {post.faqs.map(faq => (
            <details class="group bg-white border border-border rounded-lg shadow-sm">
              <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-heading hover:text-primary transition-colors">
                {faq.question}
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-4 text-body text-sm leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Author Bio -->
    <section class="mt-12 mb-8 bg-light-gray rounded-2xl p-6 md:p-8">
      <div class="flex items-start gap-4">
        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-primary to-primary-dark flex items-center justify-center text-white font-bold text-xl shadow-md flex-shrink-0">
          ZP
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-bold text-heading mb-1">About the author</h3>
          <p class="text-sm font-semibold text-heading mb-2">
            <a href="/about" class="hover:text-primary transition-colors">Zack Pearson</a>
            <span class="text-gray-400 font-normal ml-1">· Founder, PaintPro Calculator</span>
          </p>
          <p class="text-sm text-body leading-relaxed">
            Zack self-contracted his own home build in Ohio and started keeping a paint-buying spreadsheet after running out of paint mid-coat on a bedroom wall. That spreadsheet became this site. He writes every article here and verifies coverage rates and prices against manufacturer data sheets before publishing.
            <a href="/about" class="text-primary hover:underline whitespace-nowrap ml-1">Read more</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-12 mb-8">
        <h2 class="text-2xl font-bold text-heading mb-6">Related Articles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedPosts.map(related => {
            const relBadgeColor = categoryColors[related.category] || 'bg-gray-100 text-gray-800';
            return (
              <a
                href={`/blog/${related.slug}`}
                class="group block bg-white rounded-xl border border-border p-4 shadow-sm hover:shadow-md hover:border-primary/30 transition-all"
              >
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${relBadgeColor}`}>{related.category}</span>
                <h3 class="font-semibold text-heading group-hover:text-primary transition-colors mt-2 mb-1 line-clamp-2 text-sm">{related.title}</h3>
                <span class="text-xs text-gray-400">{related.readingTime} min read</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <div class="mt-10 bg-light-gray rounded-xl p-6 text-center">
      <p class="font-semibold text-heading mb-2">Ready to Start Your Project?</p>
      <p class="text-sm text-body mb-4">Use the calculator to estimate your paint before you shop.</p>
      <a
        href="/#calculator"
        class="inline-block bg-accent hover:bg-accent-dark text-white font-semibold py-2.5 px-6 rounded-lg transition-all shadow-md hover:shadow-lg"
      >
        Calculate Paint Needed
      </a>
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .blog-prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-heading);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .blog-prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-heading);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .blog-prose :global(p) {
    color: var(--color-body);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .blog-prose :global(ul),
  .blog-prose :global(ol) {
    color: var(--color-body);
    line-height: 1.75;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .blog-prose :global(ul) {
    list-style-type: disc;
  }
  .blog-prose :global(ol) {
    list-style-type: decimal;
  }
  .blog-prose :global(li) {
    margin-bottom: 0.375rem;
  }
  .blog-prose :global(strong) {
    color: var(--color-heading);
    font-weight: 600;
  }
  .blog-prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-prose :global(a:hover) {
    color: var(--color-primary-dark);
  }
</style>
