---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogPosts } from '../../data/blog-posts';
import { indexableBlogSlugs } from '../../config/indexing';

const siteUrl = 'https://paintprocalculator.com';
const reviewedPosts = blogPosts.filter((post) => indexableBlogSlugs.has(post.slug));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": `${siteUrl}/blog`,
    },
  ],
};
---

<Layout
  title="Paint Calculator Blog - Tips, Costs & Guides | PaintPro Calculator"
  description="Plain-language painting guides, cost breakdowns, and lessons from maintaining the PaintPro Calculator."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Blog' },
  ]} />

  <!-- Intro -->
  <section class="mx-auto max-w-4xl px-4 pb-8 pt-6 md:pb-12 md:pt-10">
    <p class="text-sm text-muted">Reviewed guides</p>
    <h1 class="blog-title">Paint Calculator Blog</h1>
    <p class="mt-5 max-w-xl text-[1.1875rem] leading-[1.55]">
      Practical notes on estimating, preparation, application, and the mistakes that cost time or paint.
    </p>
  </section>

  <!-- Post list: one column on phones, two ruled columns from md up -->
  <div class="mx-auto max-w-4xl px-4 pb-12 md:pb-16">
    <ul class="post-list" role="list">
      {reviewedPosts.map(post => (
        <li>
          <a href={`/blog/${post.slug}`} class="post-item">
            <span class="post-cat">{post.category}</span>
            <span class="post-read">{post.readingTime} min read</span>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-desc">{post.metaDescription}</p>
            <time class="post-date" datetime={post.publishedDate}>
              {new Date(post.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            <span class="post-more">Read more</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- CTA -->
  <div class="mx-auto max-w-4xl px-4 pb-14 md:pb-20">
    <div class="panel flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
      <div>
        <h2 class="cta-heading">Ready to Start Your Project?</h2>
        <p class="mt-1 text-[0.9375rem]">Use the calculator to make a sensible buying estimate before you head to the store.</p>
      </div>
      <a href="/#calculator" class="btn btn-primary shrink-0">Try the Paint Calculator</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .blog-title {
    margin-top: 0.75rem;
    font-size: clamp(2.5rem, 1.85rem + 2.6vw, 3.5rem);
  }

  .cta-heading {
    font-size: 1.75rem;
    line-height: 1.12;
  }

  /*
    The list. Every post is one link with a hairline above it. The link's parts sit in a grid so the
    category, date and reading time share one small line while the markup keeps the original order.
  */
  .post-list {
    display: grid;
    column-gap: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .post-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post-list > li {
    display: flex;
  }

  .post-item {
    display: grid;
    flex: 1;
    min-width: 0;
    grid-template-columns: auto auto 1fr;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      "cat   date  read"
      "title title title"
      "desc  desc  desc"
      "more  more  more";
    column-gap: 1.25rem;
    padding-block: 1.5rem 1.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-muted);
    transition: border-color 150ms ease;
  }

  .post-item:hover {
    border-top-color: var(--color-heading);
  }

  .post-cat {
    grid-area: cat;
  }

  .post-date {
    grid-area: date;
  }

  .post-read {
    grid-area: read;
  }

  .post-title {
    grid-area: title;
    margin-top: 0.625rem;
    font-size: 1.625rem;
    line-height: 1.12;
  }

  .post-item:hover .post-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .post-desc {
    grid-area: desc;
    margin-top: 0.625rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-body);
  }

  .post-more {
    grid-area: more;
    justify-self: start;
    align-self: end;
    margin-top: 0.75rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .post-item:hover .post-more {
    color: var(--color-primary-dark);
    text-decoration-thickness: 2px;
  }
</style>
