---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogPosts } from '../../data/blog-posts';
import { indexableBlogSlugs } from '../../config/indexing';

const siteUrl = 'https://paintprocalculator.com';
const reviewedPosts = blogPosts.filter((post) => indexableBlogSlugs.has(post.slug));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": `${siteUrl}/blog`,
    },
  ],
};

// Category badge colors
const categoryColors: Record<string, string> = {
  'Cost Guide': 'bg-green-100 text-green-800',
  'Paint Guide': 'bg-blue-100 text-blue-800',
  'Painting Tips': 'bg-amber-100 text-amber-800',
  'Brand Comparison': 'bg-purple-100 text-purple-800',
  'How-To Guide': 'bg-rose-100 text-rose-800',
};
---

<Layout
  title="Paint Calculator Blog - Tips, Costs & Guides | PaintPro Calculator"
  description="Plain-language painting guides, cost breakdowns, and lessons from maintaining the PaintPro Calculator."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Blog' },
  ]} />

  <!-- Hero -->
  <div class="bg-gradient-to-b from-slate-50 to-secondary">
    <div class="h-1 bg-gradient-to-r from-amber-400 via-rose-400 to-cyan-400"></div>
    <div class="max-w-4xl mx-auto px-4 py-10 text-center">
      <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1 rounded-full mb-4">Reviewed guides</span>
      <h1 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="text-gradient">Paint Calculator</span> Blog
      </h1>
      <p class="text-body text-lg leading-relaxed max-w-2xl mx-auto">
        Practical notes on estimating, preparation, application, and the mistakes that cost time or paint.
      </p>
    </div>
  </div>

  <!-- Blog Grid -->
  <div class="max-w-4xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviewedPosts.map(post => {
        const badgeColor = categoryColors[post.category] || 'bg-gray-100 text-gray-800';
        return (
          <a
            href={`/blog/${post.slug}`}
            class="group block bg-white rounded-xl border border-border shadow-sm hover:shadow-md hover:border-primary/30 transition-all overflow-hidden"
          >
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full ${badgeColor}`}>{post.category}</span>
                <span class="text-xs text-gray-400">{post.readingTime} min read</span>
              </div>
              <h2 class="font-semibold text-heading group-hover:text-primary transition-colors mb-2 line-clamp-2">{post.title}</h2>
              <p class="text-sm text-body line-clamp-3">{post.metaDescription}</p>
              <div class="mt-4 flex items-center justify-between">
                <time class="text-xs text-gray-400" datetime={post.publishedDate}>
                  {new Date(post.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <span class="text-sm font-medium text-primary group-hover:underline flex items-center gap-1">
                  Read more
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <!-- CTA -->
  <div class="max-w-4xl mx-auto px-4 pb-10">
    <div class="bg-light-gray rounded-2xl p-8 text-center">
      <h2 class="text-xl font-bold text-heading mb-2">Ready to Start Your Project?</h2>
      <p class="text-body mb-4">Use the calculator to make a sensible buying estimate before you head to the store.</p>
      <a
        href="/#calculator"
        class="inline-block bg-accent hover:bg-accent-dark text-white font-semibold py-3 px-8 rounded-lg transition-all shadow-md hover:shadow-lg text-lg"
      >
        Try the Paint Calculator
      </a>
    </div>
  </div>

  <Footer />
</Layout>
