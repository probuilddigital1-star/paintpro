---
// Stays white on purpose: this page is shown inside other people's sites, so it must not tint
// their page with the linen background. EmbedLayout sets the white body.
import EmbedLayout from '../layouts/EmbedLayout.astro';
import Calculator from '../components/Calculator.astro';
---

<EmbedLayout title="PaintPro Calculator - Embeddable Widget">
  <main class="mx-auto max-w-4xl py-4">
    <Calculator showPainterCta={false} />

    <div class="mt-6 pb-4 text-center">
      <a
        href="https://paintprocalculator.com"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm text-muted underline decoration-border-strong decoration-1 underline-offset-4 transition-[color,text-decoration-color] hover:text-primary hover:decoration-current"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"/>
          <path d="M7 17h10c.55 0 1-.45 1-1v-4c0-.55-.45-1-1-1H7c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1zm1-4h8v2H8v-2z"/>
          <path d="M17 7H7v2h10V7z"/>
        </svg>
        Powered by PaintPro Calculator
      </a>
    </div>
  </main>
</EmbedLayout>
