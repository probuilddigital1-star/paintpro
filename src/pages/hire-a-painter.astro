---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const siteUrl = 'https://paintprocalculator.com';
const pageUrl = `${siteUrl}/hire-a-painter`;

const steps = [
  {
    title: 'Tell us about the project.',
    detail: 'Pick the type of painting work, enter your zip code, and add your contact details.',
  },
  {
    title: 'Painters near you get the details.',
    detail: 'Networx passes your request to painters who work in your area.',
  },
  {
    title: 'Compare quotes and pick one.',
    detail: 'Talk with the painters who reach out and compare what they quote before you decide.',
  },
];

const faqs = [
  {
    question: 'Does it cost anything to request quotes?',
    answer: "There's no charge for using the form, and you're not obligated to hire anyone.",
  },
  {
    question: 'How many painters will contact me?',
    answer: 'That depends on how many painters in the network serve your area. You may hear from more than one.',
  },
  {
    question: 'What happens with my information?',
    answer:
      'It goes to Networx, the contractor matching network that runs this form, so painters can contact you about this project. Their privacy policy is linked in the form.',
  },
  {
    question: 'Can I still use the calculator?',
    answer:
      'Yes. Use the paint calculator to estimate how much paint the job needs before you get quotes, so you have a number to compare the bids against.',
    answerHtml:
      'Yes. Use the <a href="/#calculator" class="text-primary hover:underline">paint calculator</a> to estimate how much paint the job needs before you get quotes, so you have a number to compare the bids against.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Find a Painter', item: pageUrl },
  ],
};
---

<Layout
  title="Find a Painter Near You | PaintPro Calculator"
  description="Tell us about your painting project and get matched with local painters who can quote the job."
>
  <link slot="head" rel="preconnect" href="https://api.networx.com" />

  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Find a Painter' },
  ]} />

  <main class="max-w-4xl mx-auto px-4 pb-12">
    {/*
      The form comes first: visitors arrive from a "Get painter quotes" button, and on a phone the
      form used to start a full screen down, below the intro and the three steps. Keep this heading
      block short so the form's top edge lands inside the first screen on a phone.
    */}
    <section class="pt-3 pb-5">
      <h1 class="text-3xl md:text-4xl font-bold text-heading mb-2">Find a Painter for Your Project</h1>
      <p class="text-body leading-relaxed">
        Interior, exterior, cabinets, trim, whole house. Any size job.
      </p>
    </section>

    <section id="quote-form" class="pb-8">
      <h2 class="text-2xl font-bold text-heading mb-3">Request quotes for your project</h2>

      <div class="bg-white rounded-2xl shadow-sm border border-border p-3 md:p-5">
        <!--
          Networx form embed, exactly as Networx issues it.
          We previously hard-coded the <iframe> that their loader builds, copied from a curl request.
          That copy had an empty referrer parameter because curl sends no Referer header. In a real
          browser the loader (iframe.php) fills referrer with our page address, and Networx may use
          that value, or the loader request itself, to count views for our account. So the loader
          runs as issued: it finds the div with id="nx_form" and appends the iframe into it (then
          renames the id). Keep that id and keep the script inside it. is:inline stops Astro from
          bundling or moving the script.
          The 435px height on nx_form reserves the form's space so nothing shifts when it loads.
          Measured 2026-09-07: the rendered form is 432 to 433px tall at every width from 320px to
          900px (its wrapper has a fixed min-height with overflow hidden), so one height covers all.
        -->
        <div id="networx_form_container" style="margin:0px;padding:0px;">
            <div id="nx_form" style="height: 435px;">
                <script is:inline type="text/javascript" src="https://api.networx.com/iframe.php?aff_id=0dceb0ffa039ab83600259310bccae25&aff_to_form_id=8184"></script>
            </div>
        </div>
      </div>
    </section>

    <p class="text-body leading-relaxed pb-8">
      If you've run the numbers and decided this is a job for a pro, this is the next step. Fill out the short form above with your zip code and a few details about the project, and painters in your area will reach out to quote it.
    </p>

    <section id="how-it-works" class="pb-10">
      <h2 class="text-2xl font-bold text-heading mb-4">How it works</h2>
      <ol class="list-decimal pl-6 space-y-3 text-body leading-relaxed">
        {steps.map((step) => (
          <li>
            <span class="font-semibold text-heading">{step.title}</span> {step.detail}
          </li>
        ))}
      </ol>
    </section>

    <section id="faq" class="pb-10">
      <h2 class="text-2xl font-bold text-heading mb-6">Frequently asked questions</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div>
            <h3 class="text-lg font-semibold text-heading mb-1">{faq.question}</h3>
            {faq.answerHtml ? (
              <p class="text-body leading-relaxed" set:html={faq.answerHtml} />
            ) : (
              <p class="text-body leading-relaxed">{faq.answer}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <p class="text-sm text-gray-500 leading-relaxed border-t border-border pt-6">
      The quote form on this page is provided by Networx. PaintPro Calculator may earn a referral fee when a project is matched with a painter. This does not affect the quotes you receive.
      <a href="/affiliate-disclosure" class="text-primary hover:underline">Read the full affiliate disclosure.</a>
    </p>
  </main>

  <!--
    Placement and form-start tracking. Internal links to this page carry ?src=<placement> (nav,
    footer, calc, ...). GA4 is loaded site-wide by CookieConsent.astro after page load and only
    when the visitor has not opted out, so each event waits briefly for window.gtag and then
    sends once.

    quote_page_view  on load, only when the URL carries a valid src.
    quote_form_focus the first time the visitor clicks or tabs into the Networx form, with the
                     same src, or "direct" when there is none. The form is a cross-origin iframe,
                     so the page cannot see inside it. What it can see is the window losing focus
                     while document.activeElement becomes that iframe. Nothing the visitor types
                     is read or sent.
  -->
  <script is:inline>
    (function () {
      var src = 'direct';
      var hasSrc = false;
      try {
        var raw = new URLSearchParams(window.location.search).get('src');
        if (raw) {
          raw = String(raw).trim().slice(0, 40);
          if (/^[A-Za-z0-9_-]+$/.test(raw)) {
            src = raw;
            hasSrc = true;
          }
        }
      } catch (e) {}

      // Send one event, honoring the opt-out and waiting up to 10 seconds for gtag to load.
      function track(name) {
        var tries = 0;

        function send() {
          try {
            if (localStorage.getItem('cookie_consent') === 'opted_out') return;
          } catch (e) {}
          if (typeof window.gtag === 'function') {
            window.gtag('event', name, { src: src });
            return;
          }
          if (++tries < 40) setTimeout(send, 250);
        }

        send();
      }

      if (hasSrc) track('quote_page_view');

      // The window's focus-loss event name is built from two pieces on purpose. Tailwind scans this
      // file for class names, and the whole word is also a Tailwind class, so spelling it out
      // would add an unused rule to the stylesheet that every page loads.
      var FOCUS_LOST = 'bl' + 'ur';
      var focusSent = false;

      function onFocusLost() {
        // Wait a tick so document.activeElement has moved onto the iframe.
        setTimeout(function () {
          if (focusSent) return;
          var box = document.getElementById('networx_form_container');
          var el = document.activeElement;
          if (!box || !el || el.tagName !== 'IFRAME' || !box.contains(el)) return;
          focusSent = true;
          window.removeEventListener(FOCUS_LOST, onFocusLost);
          track('quote_form_focus');
        }, 0);
      }

      window.addEventListener(FOCUS_LOST, onFocusLost);
    })();
  </script>

  <Footer />
</Layout>
