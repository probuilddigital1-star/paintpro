---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import PainterQuoteCta from '../components/PainterQuoteCta.astro';
import AffiliateCards from '../components/AffiliateCards.astro';
import LeadGenForm from '../components/LeadGenForm.astro';
import SEOContent from '../components/SEOContent.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
---

<Layout
  title="Free Paint Calculator - How Much Paint Do I Need? | PaintPro Calculator"
  description="Free paint calculator to estimate how many gallons you need. Calculate paint coverage for walls, ceilings & trim. Works for any room size with door/window deductions."
>
  <Header />

  <main>
    <Hero />
    <div class="max-w-4xl mx-auto px-4"><AdSlot format="horizontal" /></div>
    <Calculator />
    <PainterQuoteCta pageSource="home" fallbackHref="#lead-section" />
    <section class="max-w-4xl mx-auto px-4 pb-8">
      <div class="rounded-3xl border border-border bg-white p-6 md:p-8 shadow-sm flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">New</p>
          <h2 class="mt-2 text-2xl font-bold text-heading">Plan a whole project, not just one room.</h2>
          <p class="mt-3 text-body">
            Add multiple rooms, keep primer separate, save the plan locally, and print a shopping sheet before you buy.
          </p>
        </div>
        <a href="/paint-planner" class="inline-flex items-center justify-center rounded-xl bg-accent px-5 py-3 font-semibold text-white shadow-sm hover:bg-accent-dark">
          Open Project Planner
        </a>
      </div>
    </section>
    <AffiliateCards />
    <div class="max-w-4xl mx-auto px-4"><AdSlot format="rectangle" /></div>
    <LeadGenForm />
    <SEOContent />
    <FAQ />
  </main>

  <Footer />
</Layout>
