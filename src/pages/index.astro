---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import PainterQuoteCTA from '../components/PainterQuoteCTA.astro';
import AffiliateCards from '../components/AffiliateCards.astro';
import LeadGenForm from '../components/LeadGenForm.astro';
import SEOContent from '../components/SEOContent.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
---

<Layout
  title="Free Paint Calculator - How Much Paint Do I Need? | PaintPro Calculator"
  description="Free paint calculator to estimate how many gallons you need. Calculate paint coverage for walls, ceilings & trim. Works for any room size with door/window deductions."
>
  <Header />

  <main>
    <Hero />
    <div class="max-w-4xl mx-auto px-4"><AdSlot format="horizontal" /></div>
    <Calculator />
    <section class="mx-auto max-w-4xl px-4 pt-6 pb-4 md:pt-10">
      <div class="panel flex flex-col gap-6 p-6 md:flex-row md:items-center md:justify-between md:gap-10 md:p-8">
        <div class="max-w-xl">
          <h2 class="text-[1.75rem] md:text-[2rem]">Plan a whole project, not just one room.</h2>
          <p class="mt-2">
            Add multiple rooms, keep primer separate, save the plan locally, and print a shopping sheet before you buy.
          </p>
        </div>
        <a href="/paint-planner" class="btn btn-secondary shrink-0 self-start md:self-center">
          Open Project Planner
        </a>
      </div>
    </section>
    <AffiliateCards />
    <div class="max-w-4xl mx-auto px-4"><AdSlot format="rectangle" /></div>
    <LeadGenForm />
    <section class="mx-auto max-w-2xl px-4 pt-12 md:pt-16">
      <PainterQuoteCTA src="home" />
    </section>
    <SEOContent />
    <div class="mx-auto max-w-4xl px-4"><div class="border-t border-border"></div></div>
    <FAQ />
  </main>

  <Footer />
</Layout>
