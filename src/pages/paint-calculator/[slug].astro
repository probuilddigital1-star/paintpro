---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StaticResults from '../../components/StaticResults.astro';
import AffiliateCards from '../../components/AffiliateCards.astro';
import PageFAQ from '../../components/PageFAQ.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import { calculatorPages, type CalculatorPageData } from '../../data/calculator-pages';
import { calculatePaint } from '../../utils/paint-calculator';

export function getStaticPaths() {
  return calculatorPages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: CalculatorPageData;
}

const { page } = Astro.props;

// Pre-calculate results at build time
const results = calculatePaint(page.defaults);

const currentDate = new Date().toISOString().split('T')[0];
const siteUrl = 'https://paintprocalculator.com';
const pageUrl = `${siteUrl}/paint-calculator/${page.slug}`;

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Paint Calculator",
      "item": `${siteUrl}/paint-calculator`,
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": page.h1,
      "item": pageUrl,
    },
  ],
};

// WebPage schema
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": page.title,
  "description": page.metaDescription,
  "url": pageUrl,
  "datePublished": "2026-02-25",
  "dateModified": currentDate,
  "publisher": {
    "@type": "Organization",
    "name": "ProBuild Digital LLC",
    "url": "https://probuilddigital.com",
  },
  "breadcrumb": breadcrumbSchema,
};

// FAQ schema
const faqSchema = page.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": page.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
      "author": {
        "@type": "Organization",
        "name": "ProBuild Digital LLC",
      },
      "dateModified": currentDate,
    },
  })),
  "lastReviewed": currentDate,
  "reviewedBy": {
    "@type": "Organization",
    "name": "ProBuild Digital LLC",
  },
} : null;
---

<Layout title={page.title} description={page.metaDescription}>
  <Header />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Paint Calculator', href: '/paint-calculator' },
    { name: page.h1 },
  ]} />

  <!-- Hero / Intro -->
  <section class="max-w-4xl mx-auto px-4 pt-6 pb-2">
    <h1 class="text-3xl md:text-4xl font-bold text-heading mb-4">{page.h1}</h1>
    <p class="text-body text-lg leading-relaxed max-w-3xl">{page.introText}</p>
  </section>

  <!-- Brand Disclaimer -->
  {page.brandDisclaimer && (
    <div class="max-w-4xl mx-auto px-4 pt-2 pb-2">
      <p class="text-xs text-gray-500 italic">{page.brandDisclaimer}</p>
    </div>
  )}

  <!-- Color Change Scenario Explanation -->
  {page.scenarioExplanation && (
    <section class="max-w-2xl mx-auto px-4 py-4">
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-5">
        <h2 class="font-semibold text-amber-800 mb-2 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Why This Matters
        </h2>
        <p class="text-sm text-amber-900">{page.scenarioExplanation}</p>
      </div>
    </section>
  )}

  <!-- Pre-calculated Results -->
  <StaticResults results={results} inputs={page.defaults} />

  <!-- CTA to Interactive Calculator -->
  <div class="max-w-2xl mx-auto px-4 pb-8">
    <a
      href="/#calculator"
      class="cta-link block w-full text-center bg-accent hover:bg-accent-dark text-white font-semibold py-4 px-6 rounded-lg transition-all shadow-md hover:shadow-lg text-lg"
      data-cta-text="Customize This Calculation"
      data-page-source={page.slug}
    >
      Customize This Calculation
      <span class="block text-sm font-normal mt-1 opacity-90">Adjust dimensions, texture, primer, and more</span>
    </a>
  </div>

  <!-- Room-specific Tips -->
  {page.tips.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 py-8">
      <h2 class="text-2xl font-bold text-heading mb-4 flex items-center gap-2">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Tips for This Room
      </h2>
      <div class="bg-blue-50 rounded-lg border border-blue-100 p-5">
        <ul class="space-y-2 text-sm text-body">
          {page.tips.map(tip => (
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Brand Comparison Table -->
  {page.brandComparisonTable && (
    <section class="max-w-4xl mx-auto px-4 py-8">
      <h2 class="text-2xl font-bold text-heading mb-4 flex items-center gap-2">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Paint Brand Coverage Comparison
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-lg border border-border text-sm">
          <thead>
            <tr class="bg-light-gray">
              <th class="text-left px-4 py-3 font-semibold text-heading">Brand</th>
              <th class="text-center px-4 py-3 font-semibold text-heading">Coverage (sq ft/gal)</th>
              <th class="text-center px-4 py-3 font-semibold text-heading">Price Tier</th>
              <th class="text-center px-4 py-3 font-semibold text-heading">Calculator</th>
            </tr>
          </thead>
          <tbody>
            {page.brandComparisonTable.map((entry) => (
              <tr class={`border-t border-border ${entry.slug === page.slug ? 'bg-primary/5 font-semibold' : ''}`}>
                <td class="px-4 py-3 text-heading">{entry.brand}</td>
                <td class="px-4 py-3 text-center">{entry.coverageRate}</td>
                <td class="px-4 py-3 text-center">{entry.priceTier}</td>
                <td class="px-4 py-3 text-center">
                  {entry.slug === page.slug ? (
                    <span class="text-primary text-xs">You are here</span>
                  ) : (
                    <a href={`/paint-calculator/${entry.slug}`} class="text-primary hover:underline text-xs">
                      Calculate
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Affiliate Cards -->
  <AffiliateCards products={page.affiliates} pageSource={page.slug} />

  <!-- FAQ -->
  <PageFAQ faqs={page.faqs} />

  <!-- Related Pages -->
  <RelatedPages slugs={page.relatedPages} />

  <Footer />
</Layout>

<script>
  import { trackCtaClick } from '../../utils/analytics';

  document.querySelectorAll<HTMLAnchorElement>('.cta-link').forEach((link) => {
    link.addEventListener('click', () => {
      trackCtaClick({
        ctaText: link.dataset.ctaText,
        pageSource: link.dataset.pageSource,
      });
    });
  });
</script>
