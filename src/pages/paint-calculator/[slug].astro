---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StaticResults from '../../components/StaticResults.astro';
import PainterQuoteCTA from '../../components/PainterQuoteCTA.astro';
import AffiliateCards from '../../components/AffiliateCards.astro';
import PageFAQ from '../../components/PageFAQ.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import AdSlot from '../../components/AdSlot.astro';
import { calculatorPages, type CalculatorPageData } from '../../data/calculator-pages';
import { calculatePaint } from '../../utils/paint-calculator';
import { indexableCalculatorSlugs } from '../../config/indexing';

export function getStaticPaths() {
  return calculatorPages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: CalculatorPageData;
}

const { page } = Astro.props;

// Pre-calculate results at build time
const results = calculatePaint(page.defaults);

const updatedDate = '2026-02-25';
const indexable = indexableCalculatorSlugs.has(page.slug);

// Receipt subline: room pages name the room ("garage", "dining room"); size, brand and color
// pages use a generic room, since their room type is only a default.
const roomLabel = page.pageType === 'room-type'
  ? page.slug.replace(/-paint-calculator$/, '').replace(/-/g, ' ')
  : 'room';

// Reference table columns that hold numbers (every cell starts with a digit) are right-aligned.
const numericColumns = page.dataTable
  ? page.dataTable.columns.map((_, i) => i > 0 && page.dataTable!.rows.every((row) => /^\d/.test(row[i]?.trim() ?? '')))
  : [];
const siteUrl = 'https://paintprocalculator.com';
const pageUrl = `${siteUrl}/paint-calculator/${page.slug}`;

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Paint Calculator",
      "item": `${siteUrl}/paint-calculator`,
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": page.h1,
      "item": pageUrl,
    },
  ],
};

// WebPage schema
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": page.title,
  "description": page.metaDescription,
  "url": pageUrl,
  "datePublished": "2026-02-25",
  "dateModified": updatedDate,
  "publisher": {
    "@type": "Organization",
    "name": "ProBuild Digital LLC",
    "url": "https://probuilddigital.com",
  },
  "breadcrumb": breadcrumbSchema,
};

// FAQ schema
const faqSchema = page.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": page.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
      "author": {
        "@type": "Organization",
        "name": "ProBuild Digital LLC",
      },
      "dateModified": updatedDate,
    },
  })),
  "lastReviewed": updatedDate,
  "reviewedBy": {
    "@type": "Organization",
    "name": "ProBuild Digital LLC",
  },
} : null;
---

<Layout title={page.title} description={page.metaDescription} indexable={indexable}>
  <Header />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Paint Calculator', href: '/paint-calculator' },
    { name: page.h1 },
  ]} />

  <!-- Intro -->
  <section class="mx-auto max-w-4xl px-4 pt-4 pb-2 md:pt-8">
    <h1 class="text-[2.5rem] md:text-[3.75rem]">{page.h1}</h1>
    <p class="mt-5 max-w-[34rem] text-[1.0625rem] leading-relaxed md:text-[1.1875rem]">{page.introText}</p>
  </section>

  <div class="max-w-4xl mx-auto px-4"><AdSlot format="horizontal" /></div>

  <!-- Brand Disclaimer -->
  {page.brandDisclaimer && (
    <div class="mx-auto max-w-4xl px-4 pt-3">
      <p class="max-w-[34rem] text-[0.8125rem] leading-normal text-muted">{page.brandDisclaimer}</p>
    </div>
  )}

  <!-- Color Change Scenario Explanation -->
  {page.scenarioExplanation && (
    <section class="mx-auto max-w-4xl px-4 pt-8">
      <div class="callout max-w-[40rem]">
        <h2 class="text-[1.5rem]">Why This Matters</h2>
        <p class="mt-2 text-[0.9375rem] leading-relaxed">{page.scenarioExplanation}</p>
      </div>
    </section>
  )}

  <!-- Pre-calculated Results -->
  <StaticResults results={results} inputs={page.defaults} brand={page.brand} pageSource={page.slug} roomLabel={roomLabel}>
    <PainterQuoteCTA slot="after-estimate" src="calc-page" heading="Rather have a pro do it?" body="You've got your paint numbers. Get quotes from local painters for this job." />
  </StaticResults>

  {page.measurementGuide && (
    <section class="mx-auto max-w-4xl px-4 pt-14 pb-4 md:pt-20">
      <p class="text-[0.9375rem] text-muted">Before using the preset</p>
      <h2 class="mt-1 text-[1.875rem] md:text-[2.5rem]">Measure this room without the usual shortcuts</h2>
      <p class="mt-4 max-w-[36rem]">
        The result above is a worked example using the dimensions and openings shown in the breakdown. Use these room-specific checks before treating it as a shopping quantity.
      </p>
      <ol class="mt-8 grid gap-x-10 md:grid-cols-3">
        {page.measurementGuide.map((item) => (
          <li class="border-t border-border pt-4 pb-6 text-[0.9375rem] leading-relaxed">{item}</li>
        ))}
      </ol>
    </section>
  )}

  <!-- CTA to Interactive Calculator. Outline pill: the painter card's terracotta pill is the
       one filled button near here. -->
  <section class="mx-auto max-w-4xl px-4 pt-8 pb-10 md:pb-14">
    <div class="flex flex-col items-start gap-x-6 gap-y-3 sm:flex-row sm:items-center">
      <a
        href="/#calculator"
        class="cta-link btn btn-secondary"
        data-cta-text="Customize This Calculation"
        data-page-source={page.slug}
      >
        Customize This Calculation
      </a>
      <p class="text-[0.9375rem] text-muted">Adjust dimensions, texture, primer, and more</p>
    </div>
    <p class="mt-5">
      <a href="/paint-planner" class="link text-[0.9375rem]">Estimating several rooms? Build one combined project plan</a>
    </p>
  </section>

  <!-- Room-specific Tips -->
  {page.tips.length > 0 && (
    <section class="mx-auto max-w-4xl px-4 py-10 md:py-14">
      <h2 class="text-[1.875rem] md:text-[2.5rem]">Tips for This Room</h2>
      <ul class="mt-6 grid gap-x-12 md:grid-cols-2">
        {page.tips.map(tip => (
          <li class="border-t border-border py-4 leading-relaxed">{tip}</li>
        ))}
      </ul>
    </section>
  )}

  <!-- Reference table (gallons by garage size, coverage by product line) -->
  {page.dataTable && (
    <section class="mx-auto max-w-4xl px-4 py-10 md:py-14">
      <h2 class="text-[1.875rem] md:text-[2.5rem]">{page.dataTable.title}</h2>
      {page.dataTable.intro && <p class="mt-4 max-w-[36rem]">{page.dataTable.intro}</p>}
      <div class="mt-6 overflow-x-auto">
        <table class="table-ruled calc-table">
          <thead>
            <tr>
              {page.dataTable.columns.map((col, i) => (
                <th class:list={[{ 'text-right': numericColumns[i] }]}>{col}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {page.dataTable.rows.map((row) => (
              <tr>
                {row.map((cell, i) => (
                  <td class:list={[{ 'row-label': i === 0, 'text-right': numericColumns[i] }]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {page.dataTable.footnote && <p class="mt-4 max-w-[40rem] text-[0.8125rem] leading-normal text-muted">{page.dataTable.footnote}</p>}
    </section>
  )}

  <!-- Brand Comparison Table -->
  {page.brandComparisonTable && (
    <section class="mx-auto max-w-4xl px-4 py-10 md:py-14">
      <h2 class="text-[1.875rem] md:text-[2.5rem]">Paint Brand Coverage Comparison</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="table-ruled calc-table">
          <thead>
            <tr>
              <th>Brand</th>
              <th class="text-right">Coverage (sq ft/gal)</th>
              <th>Price Tier</th>
              <th>Calculator</th>
            </tr>
          </thead>
          <tbody>
            {page.brandComparisonTable.map((entry) => (
              <tr class:list={[{ 'is-current': entry.slug === page.slug }]}>
                <td class="row-label">{entry.brand}</td>
                <td class="text-right">{entry.coverageRate}</td>
                <td>{entry.priceTier}</td>
                <td>
                  {entry.slug === page.slug ? (
                    <span>You are here</span>
                  ) : (
                    <a href={`/paint-calculator/${entry.slug}`} class="link">
                      Calculate
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Affiliate Cards -->
  <AffiliateCards products={page.affiliates} pageSource={page.slug} />

  <!-- FAQ -->
  <PageFAQ faqs={page.faqs} />

  <div class="max-w-4xl mx-auto px-4"><AdSlot format="rectangle" /></div>

  <!-- Related Pages -->
  <RelatedPages slugs={page.relatedPages} />

  <Footer />
</Layout>

<style>
  /* Row labels in ink. The row for this page is marked with weight, not a tinted fill. */
  .calc-table .row-label {
    color: var(--color-heading);
    font-weight: 500;
  }

  .calc-table .is-current td {
    color: var(--color-heading);
    font-weight: 600;
  }

  /* A notch smaller on phones so the five-column garage table and the brand table fit at 360px. */
  @media (max-width: 639px) {
    .calc-table {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  import { trackCtaClick } from '../../utils/analytics';

  document.querySelectorAll<HTMLAnchorElement>('.cta-link').forEach((link) => {
    link.addEventListener('click', () => {
      trackCtaClick({
        ctaText: link.dataset.ctaText,
        pageSource: link.dataset.pageSource,
      });
    });
  });
</script>
