---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { calculatorPages } from '../../data/calculator-pages';

const roomTypePages = calculatorPages.filter(p => p.pageType === 'room-type');
const roomSizePages = calculatorPages.filter(p => p.pageType === 'room-size');
const brandPages = calculatorPages.filter(p => p.pageType === 'brand');
const colorChangePages = calculatorPages.filter(p => p.pageType === 'color-change');

const siteUrl = 'https://paintprocalculator.com';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Paint Calculator",
      "item": `${siteUrl}/paint-calculator`,
    },
  ],
};

// Color change visual data
const colorChangeVisuals: Record<string, { from: string; to: string; fromLabel: string; toLabel: string; coats: number; primer: boolean }> = {
  'dark-to-light-paint-calculator': { from: '#374151', to: '#F9FAFB', fromLabel: 'Dark', toLabel: 'Light', coats: 3, primer: true },
  'light-to-dark-paint-calculator': { from: '#F3F4F6', to: '#1F2937', fromLabel: 'Light', toLabel: 'Dark', coats: 2, primer: false },
  'similar-colors-paint-calculator': { from: '#D1D5DB', to: '#9CA3AF', fromLabel: 'Color A', toLabel: 'Color B', coats: 2, primer: false },
  'red-to-white-paint-calculator': { from: '#DC2626', to: '#FFFFFF', fromLabel: 'Red', toLabel: 'White', coats: 3, primer: true },
  'white-to-dark-paint-calculator': { from: '#FFFFFF', to: '#1E293B', fromLabel: 'White', toLabel: 'Dark', coats: 2, primer: true },
};
---

<Layout
  title="Paint Calculators by Room | PaintPro Calculator"
  description="Room-specific paint estimates with practical notes about openings, surface condition, primer, and finish."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Paint Calculator' },
  ]} />

  <main class="mx-auto max-w-4xl px-4 pb-16">
    <div class="pt-4 pb-10 md:pt-8 md:pb-12">
      <h1 class="mb-4 text-[2.5rem] md:text-[3.75rem]">Paint Calculator for Every Room</h1>
      <p class="max-w-[34rem] text-[1.0625rem] leading-relaxed md:text-[1.1875rem]">
        Start with the room that is closest to your project, then enter your own measurements in the main calculator.
      </p>
      <p class="mt-3 text-sm text-muted">10 room guides</p>
    </div>

    <!-- Room Type Calculators -->
    <section class="pb-10">
      <h2 class="mb-2 text-[1.875rem] md:text-[2.5rem]">By Room Type</h2>
      <p class="mb-6 max-w-[34rem]">Estimates tailored to your specific room with typical door and window counts.</p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
        {roomTypePages.map(page => (
          <a
            href={`/paint-calculator/${page.slug}`}
            class="panel block p-5 transition-[border-color] hover:border-heading"
          >
            <h3 class="mb-1.5 font-serif text-[1.375rem] leading-[1.15] font-normal tracking-[-0.01em]">{page.h1}</h3>
            <p class="line-clamp-2 text-sm leading-relaxed">{page.metaDescription.slice(0, 90)}...</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Preset pages remain available by direct URL but are not promoted while under review. -->
    {false && <section class="border-t border-border py-10">
      <h2 class="mb-2 text-[1.875rem] md:text-[2.5rem]">By Room Size</h2>
      <p class="mb-6 max-w-[34rem]">Pre-calculated estimates based on exact room dimensions.</p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
        {roomSizePages.map(page => {
          const sizeMatch = page.slug.match(/^(\d+x\d+)/);
          const sizeLabel = sizeMatch ? sizeMatch[1] : page.slug;
          const dims = sizeLabel.split('x').map(Number);
          const area = dims[0] * dims[1];
          return (
            <a
              href={`/paint-calculator/${page.slug}`}
              class="panel block p-4 transition-[border-color] hover:border-heading"
            >
              <p class="numeral text-[1.75rem] text-heading">{sizeLabel}</p>
              <p class="mt-1 text-[0.8125rem] text-muted">{area} sq ft</p>
            </a>
          );
        })}
      </div>
    </section>}

    <AdSlot format="horizontal" />

    <!-- Brand presets are retained for later editorial review. -->
    {false && <section class="border-t border-border py-10">
      <h2 class="mb-2 text-[1.875rem] md:text-[2.5rem]">By Paint Brand</h2>
      <p class="mb-6 max-w-[34rem]">Coverage rates calibrated to each brand's published specifications.</p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
        {brandPages.map(page => {
          const brandName = page.h1.replace(' Paint Coverage Calculator', '');
          const coverageRate = page.defaults.customCoverageRate ?? 400;
          return (
            <a
              href={`/paint-calculator/${page.slug}`}
              class="panel block p-4 transition-[border-color] hover:border-heading"
            >
              <p class="font-serif text-[1.375rem] leading-[1.15] text-heading">{brandName}</p>
              <p class="mt-1 text-[0.8125rem] text-muted">{coverageRate} sq ft/gal</p>
            </a>
          );
        })}
      </div>
    </section>}

    <!-- Color-change presets are retained for later editorial review. -->
    {false && <section class="border-t border-border py-10">
      <h2 class="mb-2 text-[1.875rem] md:text-[2.5rem]">By Color Change Scenario</h2>
      <p class="mb-6 max-w-[34rem]">Coat counts and primer needs adjusted for your color transition.</p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
        {colorChangePages.map(page => {
          const vis = colorChangeVisuals[page.slug];
          return (
            <a
              href={`/paint-calculator/${page.slug}`}
              class="panel block p-5 transition-[border-color] hover:border-heading"
            >
              {vis && (
                <div class="mb-3 flex items-center gap-3">
                  <div class="h-7 w-7 rounded-full border border-border-strong" style={`background-color: ${vis.from}`} title={vis.fromLabel}></div>
                  <svg class="h-4 w-4 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                  <div class="h-7 w-7 rounded-full border border-border-strong" style={`background-color: ${vis.to}`} title={vis.toLabel}></div>
                </div>
              )}
              <h3 class="mb-1 font-serif text-[1.375rem] leading-[1.15] font-normal tracking-[-0.01em]">{page.h1}</h3>
              {vis && (
                <p class="text-[0.8125rem] text-muted">
                  {vis.coats} coats{vis.primer ? ' + primer' : ', no primer needed'}
                </p>
              )}
            </a>
          );
        })}
      </div>
    </section>}

    <!-- CTA -->
    <section class="mt-4 border-t border-border pt-10 md:mt-8">
      <h2 class="mb-3 text-[1.875rem] md:text-[2.25rem]">Need a Custom Calculation?</h2>
      <p class="mb-6 max-w-[34rem]">Adjust the dimensions, texture, primer, coverage rate, and number of coats for your project.</p>
      <a href="/#calculator" class="btn btn-primary">Use Interactive Calculator</a>
    </section>
  </main>

  <Footer />
</Layout>
