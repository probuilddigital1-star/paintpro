---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { calculatorPages } from '../../data/calculator-pages';

const roomTypePages = calculatorPages.filter(p => p.pageType === 'room-type');
const roomSizePages = calculatorPages.filter(p => p.pageType === 'room-size');
const brandPages = calculatorPages.filter(p => p.pageType === 'brand');
const colorChangePages = calculatorPages.filter(p => p.pageType === 'color-change');

const siteUrl = 'https://paintprocalculator.com';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Paint Calculator",
      "item": `${siteUrl}/paint-calculator`,
    },
  ],
};

// Room icon SVGs (Heroicons outline paths)
const roomIconSvg: Record<string, string> = {
  'bedroom-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />',
  'bathroom-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />',
  'kitchen-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m15-3.379a48.474 48.474 0 00-6-.371c-2.032 0-4.034.126-6 .371m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 013 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 016 13.12M12.265 3.11a.375.375 0 11-.53 0L12 2.845l.265.265z" />',
  'living-room-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v12.25c0 .621.504 1.125 1.125 1.125z" />',
  'garage-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />',
  'hallway-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />',
  'nursery-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />',
  'office-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" />',
  'dining-room-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />',
  'basement-paint-calculator': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" />',
};

// Color change visual data
const colorChangeVisuals: Record<string, { from: string; to: string; fromLabel: string; toLabel: string; coats: number; primer: boolean }> = {
  'dark-to-light-paint-calculator': { from: '#374151', to: '#F9FAFB', fromLabel: 'Dark', toLabel: 'Light', coats: 3, primer: true },
  'light-to-dark-paint-calculator': { from: '#F3F4F6', to: '#1F2937', fromLabel: 'Light', toLabel: 'Dark', coats: 2, primer: false },
  'similar-colors-paint-calculator': { from: '#D1D5DB', to: '#9CA3AF', fromLabel: 'Color A', toLabel: 'Color B', coats: 2, primer: false },
  'red-to-white-paint-calculator': { from: '#DC2626', to: '#FFFFFF', fromLabel: 'Red', toLabel: 'White', coats: 3, primer: true },
  'white-to-dark-paint-calculator': { from: '#FFFFFF', to: '#1E293B', fromLabel: 'White', toLabel: 'Dark', coats: 2, primer: true },
};
---

<Layout
  title="Paint Calculator for Every Room, Brand & Scenario – Free Estimates"
  description="Free paint calculators for every room type, size, paint brand, and color change scenario. Get accurate gallon estimates for Behr, Sherwin-Williams, Benjamin Moore, and more."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Paint Calculator' },
  ]} />

  <!-- Mini Hero Header -->
  <div class="bg-gradient-to-b from-slate-50 to-secondary">
    <div class="h-1 bg-gradient-to-r from-amber-400 via-rose-400 to-cyan-400"></div>
    <div class="max-w-4xl mx-auto px-4 py-10 text-center">
      <span class="inline-block bg-primary/10 text-primary text-sm font-semibold px-4 py-1 rounded-full mb-4">40 Free Calculators</span>
      <h1 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="text-gradient">Paint Calculator</span> for Every Room
      </h1>
      <p class="text-body text-lg leading-relaxed max-w-2xl mx-auto">
        Choose your room type, size, paint brand, or color change scenario below to get a pre-calculated paint estimate instantly.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 pt-2 pb-10">

    <!-- Room Type Calculators -->
    <section class="py-10">
      <h2 class="text-2xl font-bold text-heading mb-2 flex items-center gap-2">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        By Room Type
      </h2>
      <p class="text-body mb-6">Estimates tailored to your specific room with typical door and window counts.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {roomTypePages.map(page => {
          const iconPath = roomIconSvg[page.slug] || '';
          return (
            <a
              href={`/paint-calculator/${page.slug}`}
              class="group flex items-start gap-4 bg-white rounded-xl border border-border p-5 shadow-sm hover:shadow-md hover:border-primary/30 transition-all"
            >
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconPath} />
              </div>
              <div>
                <h3 class="font-semibold text-heading group-hover:text-primary transition-colors mb-1">{page.h1}</h3>
                <p class="text-sm text-body line-clamp-2">{page.metaDescription.slice(0, 90)}...</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Room Size Calculators -->
    <section class="py-10 -mx-4 px-4 bg-white/50 rounded-2xl">
      <h2 class="text-2xl font-bold text-heading mb-2 flex items-center gap-2">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
        </svg>
        By Room Size
      </h2>
      <p class="text-body mb-6">Pre-calculated estimates based on exact room dimensions.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {roomSizePages.map(page => {
          const sizeMatch = page.slug.match(/^(\d+x\d+)/);
          const sizeLabel = sizeMatch ? sizeMatch[1] : page.slug;
          const dims = sizeLabel.split('x').map(Number);
          const area = dims[0] * dims[1];
          return (
            <a
              href={`/paint-calculator/${page.slug}`}
              class="group block bg-white rounded-xl border border-border p-4 shadow-sm hover:shadow-md hover:border-primary/30 transition-all text-center"
            >
              <p class="text-2xl font-bold text-heading group-hover:text-primary transition-colors">{sizeLabel}</p>
              <p class="text-xs text-body mt-1">{area} sq ft</p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Brand Calculators -->
    <section class="py-10">
      <h2 class="text-2xl font-bold text-heading mb-2 flex items-center gap-2">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
        By Paint Brand
      </h2>
      <p class="text-body mb-6">Coverage rates calibrated to each brand's published specifications.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {brandPages.map(page => {
          const brandName = page.h1.replace(' Paint Coverage Calculator', '');
          const coverageRate = page.defaults.customCoverageRate ?? 400;
          return (
            <a
              href={`/paint-calculator/${page.slug}`}
              class="group block bg-white rounded-xl border border-border p-5 shadow-sm hover:shadow-md hover:border-primary/30 transition-all text-center"
            >
              <p class="text-lg font-bold text-heading group-hover:text-primary transition-colors">{brandName}</p>
              <span class="inline-block mt-2 bg-accent/10 text-accent text-xs font-semibold px-3 py-1 rounded-full">{coverageRate} sq ft/gal</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Color Change Calculators -->
    <section class="py-10 -mx-4 px-4 bg-white/50 rounded-2xl">
      <h2 class="text-2xl font-bold text-heading mb-2 flex items-center gap-2">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
        </svg>
        By Color Change Scenario
      </h2>
      <p class="text-body mb-6">Coat counts and primer needs adjusted for your color transition.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {colorChangePages.map(page => {
          const vis = colorChangeVisuals[page.slug];
          return (
            <a
              href={`/paint-calculator/${page.slug}`}
              class="group block bg-white rounded-xl border border-border shadow-sm hover:shadow-md hover:border-primary/30 transition-all overflow-hidden"
            >
              {vis && (
                <div class="h-2 w-full" style={`background: linear-gradient(to right, ${vis.from}, ${vis.to})`}></div>
              )}
              <div class="p-5">
                {vis && (
                  <div class="flex items-center justify-center gap-3 mb-3">
                    <div class="w-8 h-8 rounded-full border-2 border-gray-200" style={`background-color: ${vis.from}`} title={vis.fromLabel}></div>
                    <svg class="w-4 h-4 text-body" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                    <div class="w-8 h-8 rounded-full border-2 border-gray-200" style={`background-color: ${vis.to}`} title={vis.toLabel}></div>
                  </div>
                )}
                <h3 class="font-semibold text-heading group-hover:text-primary transition-colors mb-1">{page.h1}</h3>
                {vis && (
                  <p class="text-xs text-body">
                    {vis.coats} coats{vis.primer ? ' + primer' : ', no primer needed'}
                  </p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <div class="bg-light-gray rounded-2xl p-8 text-center mt-10">
      <h2 class="text-xl font-bold text-heading mb-2">Need a Custom Calculation?</h2>
      <p class="text-body mb-4">Our interactive calculator lets you adjust every detail — dimensions, texture, primer, paint quality, and more.</p>
      <a
        href="/#calculator"
        class="inline-block bg-accent hover:bg-accent-dark text-white font-semibold py-3 px-8 rounded-lg transition-all shadow-md hover:shadow-lg text-lg"
      >
        Use Interactive Calculator
      </a>
    </div>
  </div>

  <Footer />
</Layout>
