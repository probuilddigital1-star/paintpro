---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PainterQuoteCTA from '../components/PainterQuoteCTA.astro';
import {
  createPaintProject,
  createPaintRoom,
  decodePaintProject,
  encodePaintProject,
  normalizePaintProject,
  summarizePaintProject,
  type PaintProject,
} from '../models/paint-project';

const projectQuery = Astro.url.searchParams.get('project');
const decodedProject = projectQuery ? decodePaintProject(projectQuery) : null;
const isSharedProject = Boolean(projectQuery && decodedProject);

function seedProject(project: PaintProject): PaintProject {
  const normalized = normalizePaintProject(project);
  if (normalized.rooms.length > 0) {
    return normalized;
  }

  return {
    ...normalized,
    rooms: [createPaintRoom('Room 1')],
  };
}

const initialProject = seedProject(decodedProject ?? createPaintProject('Whole-home paint plan'));
const initialSummary = summarizePaintProject(initialProject);
const initialShareToken = encodePaintProject(initialProject);
const plannerSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Paint Project Planner",
  "description": "Plan multiple rooms, save a project locally, and share a printable paint shopping list.",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web Browser",
  "browserRequirements": "Requires JavaScript",
  "isAccessibleForFree": true,
};
---

<Layout
  title="Paint Project Planner | Multi-Room Paint Estimate"
  description="Plan multiple rooms, save the project locally, share a link, and print a practical shopping sheet for your paint job."
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(plannerSchema)} />

  <Breadcrumbs items={[
    { name: 'Home', href: '/' },
    { name: 'Paint Project Planner' },
  ]} />

  <main class="planner-page mx-auto max-w-4xl px-4 pb-16">
    <div class="planner-no-print pt-4 pb-8 md:pt-8 md:pb-10">
      <h1 class="mb-4 text-[2.5rem] md:text-[3.75rem]">Plan the whole project in one place.</h1>
      <p class="max-w-[34rem] text-[1.0625rem] leading-relaxed md:text-[1.1875rem]">
        Add every room, keep primer separate, save the plan on this device, and create a shareable shopping sheet when you are ready to buy.
      </p>
    </div>

    <div id="planner-grid" class="grid max-w-[36rem] grid-cols-[minmax(0,1fr)] gap-6 lg:max-w-none lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:gap-10">
      <div class="planner-print-only mb-6">
        <h1 id="print-project-title" class="text-[2rem]"></h1>
        <p class="mt-1 text-sm text-muted">Paint shopping plan</p>
      </div>

      <div class="min-w-0 space-y-6">
        <section class="planner-no-print panel p-5 md:p-6">
          <label class="block">
            <span class="field-label">Project name</span>
            <input id="project-name" type="text" class="field" />
          </label>

          <div class="mt-4 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
            <button id="copy-link-btn" type="button" class="btn btn-secondary btn-sm px-2 text-[0.875rem] sm:px-4 sm:text-[0.9375rem]">Copy plan link</button>
            <button id="download-json-btn" type="button" title="Download a backup you can restore in this planner" class="btn btn-secondary btn-sm px-2 text-[0.875rem] sm:px-4 sm:text-[0.9375rem]">Download backup</button>
            <button id="open-copy-btn" type="button" title="Restore a backup you previously downloaded" class="btn btn-secondary btn-sm px-2 text-[0.875rem] sm:px-4 sm:text-[0.9375rem]">Restore backup</button>
            <button id="print-btn" type="button" title="Print the shopping sheet or save it as a PDF" class="btn btn-secondary btn-sm px-2 text-[0.875rem] sm:px-4 sm:text-[0.9375rem]">Print or save PDF</button>
            <div class="col-span-2 sm:basis-full">
              <button id="new-plan-btn" type="button" class="btn btn-ghost btn-sm px-0">Start a new plan</button>
            </div>
          </div>
          <input id="open-copy-input" type="file" accept="application/json,.json" class="sr-only" />
          <p id="save-status" class="mt-4 text-sm text-muted" role="status" aria-live="polite" tabindex="-1">Your changes are saved automatically in this browser.</p>

          <details class="disclosure mt-4 border-t border-border pt-4 text-sm">
            <summary class="-my-3 py-3 font-semibold">How saving and backups work</summary>
            <div class="mt-3 space-y-3 leading-relaxed">
              <p><strong>Staying on this device:</strong> Your plan saves automatically as you make changes. You can close this page and return later in the same browser.</p>
              <div>
                <p class="font-semibold text-heading">Moving or protecting your plan:</p>
                <ol class="mt-2 list-decimal space-y-1 pl-5 marker:text-accent">
                  <li>Select <strong>Download backup</strong> and keep the downloaded file.</li>
                  <li>When you need it, return to this planner and select <strong>Restore backup</strong>.</li>
                  <li>Choose the backup file from your Downloads folder or wherever you saved it.</li>
                </ol>
              </div>
              <p class="callout"><strong>Important:</strong> Do not open the downloaded file by itself. Restore it from this planner. Restoring a backup replaces the plan currently saved in this browser.</p>
            </div>
          </details>
        </section>

        <section id="room-list-section" class="planner-no-print panel overflow-hidden">
          <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3 p-5 md:p-6">
            <div>
              <p class="text-[0.8125rem] text-muted">Step 1</p>
              <h2 class="text-[1.75rem] md:text-[2rem]">Choose a room</h2>
            </div>
            <div class="flex items-center gap-4">
              <p id="room-count" class="hidden text-sm text-muted sm:block"></p>
              <button id="add-room-btn" type="button" class="btn btn-primary">Add room</button>
            </div>
          </div>
          <div id="room-list"></div>
        </section>

        <section id="room-editor-section" class="planner-no-print panel p-5 md:p-6">
          <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
            <div>
              <p class="text-[0.8125rem] text-muted">Step 2</p>
              <h2 class="text-[1.75rem] md:text-[2rem]">Enter room details</h2>
            </div>
            <div class="sm:text-right">
              <p id="selected-room-hint" class="text-sm text-muted first-letter:uppercase"></p>
              <a href="#room-list-section" class="link mt-1 inline-block text-sm lg:hidden">Back to rooms</a>
            </div>
          </div>
          <div id="selected-room-result" class="callout mt-5 text-sm text-heading" aria-live="polite"></div>
          <a id="mobile-project-summary" href="#shopping-list-section" class="panel-link mt-3 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 py-3 text-sm lg:hidden">
            <span id="mobile-project-total" class="font-medium text-heading"></span>
            <span class="shrink-0 font-semibold text-primary underline decoration-1 underline-offset-[3px]">View shopping list</span>
          </a>

          <form id="room-editor" class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="block">
              <span class="field-label">Room name</span>
              <input id="room-name" type="text" class="field" />
            </label>

            <label class="block">
              <span class="field-label">Room type</span>
              <select id="room-type" class="field">
                <option value="living-room">Living room</option>
                <option value="bedroom">Bedroom</option>
                <option value="kitchen">Kitchen</option>
                <option value="bathroom">Bathroom</option>
                <option value="hallway">Hallway</option>
                <option value="basement">Basement</option>
                <option value="garage">Garage</option>
                <option value="office">Office</option>
                <option value="dining-room">Dining room</option>
              </select>
            </label>

            <div class="rounded bg-light-gray p-4 md:col-span-2">
              <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                  <span class="field-label">Paint name or color</span>
                  <input id="paint-name" type="text" placeholder="Example: Soft white walls" class="field" />
                </label>
                <label class="block">
                  <span class="field-label">Sheen</span>
                  <select id="paint-sheen" class="field">
                    <option value="flat">Flat</option>
                    <option value="matte">Matte</option>
                    <option value="eggshell">Eggshell</option>
                    <option value="satin">Satin</option>
                    <option value="semi-gloss">Semi-gloss</option>
                    <option value="gloss">Gloss</option>
                  </select>
                </label>
              </div>
              <p class="field-hint mt-3">Rooms with the same paint name, sheen, and quality are combined on the shopping list.</p>
              <div id="ceiling-paint-panel" class="mt-4 hidden border-t border-border-strong pt-4">
                <p class="mb-3 text-sm font-semibold text-heading">Ceiling paint</p>
                <div class="grid gap-4 md:grid-cols-2">
                  <label class="block">
                    <span class="field-label">Paint name or color</span>
                    <input id="ceiling-paint-name" type="text" placeholder="Example: Flat ceiling white" class="field" />
                  </label>
                  <label class="block">
                    <span class="field-label">Sheen</span>
                    <select id="ceiling-paint-sheen" class="field">
                      <option value="flat">Flat</option>
                      <option value="matte">Matte</option>
                      <option value="eggshell">Eggshell</option>
                      <option value="satin">Satin</option>
                    </select>
                  </label>
                </div>
              </div>
            </div>

            <label class="block">
              <span class="field-label">Length</span>
              <span class="relative block">
                <input id="length" type="number" min="1" step="0.5" class="field pr-12" />
                <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm text-muted">ft</span>
              </span>
            </label>

            <label class="block">
              <span class="field-label">Width</span>
              <span class="relative block">
                <input id="width" type="number" min="1" step="0.5" class="field pr-12" />
                <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm text-muted">ft</span>
              </span>
            </label>

            <label class="block">
              <span class="field-label">Ceiling height</span>
              <span class="relative block">
                <input id="height" type="number" min="6" step="0.5" class="field pr-12" />
                <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm text-muted">ft</span>
              </span>
            </label>

            <label class="block">
              <span class="field-label">What are you painting?</span>
              <select id="surface-type" class="field">
                <option value="walls">Walls only</option>
                <option value="walls-ceiling">Walls + ceiling</option>
                <option value="ceiling">Ceiling only</option>
                <option value="trim">Trim only</option>
              </select>
            </label>

            <details id="fine-tune-details" class="disclosure min-w-0 rounded border border-border p-4 md:col-span-2">
              <summary class="-my-2.5 py-2.5 font-semibold">Fine-tune the estimate</summary>
              <p class="mt-2 text-sm">Adjust texture, openings, primer, and the waste allowance when those details matter for your room.</p>
              <div class="mt-4 grid min-w-0 gap-4">
                <div class="grid min-w-0 gap-4 sm:grid-cols-2">
                  <label class="block min-w-0">
                    <span class="field-label">Paint quality</span>
                    <select id="paint-quality" class="field">
                      <option value="budget">Budget</option>
                      <option value="standard">Standard</option>
                      <option value="premium">Premium</option>
                    </select>
                  </label>
                  <label class="block min-w-0">
                    <span class="field-label">Label coverage rate</span>
                    <span class="relative block">
                      <input id="custom-coverage-rate" type="number" min="1" step="1" placeholder="Optional" class="field pr-[5.5rem]" />
                      <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm text-muted">sq ft/gal</span>
                    </span>
                  </label>
                  <label class="block min-w-0">
                    <span class="field-label">Coats</span>
                    <select id="num-coats" class="field">
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                    </select>
                  </label>
                </div>

                <div class="grid min-w-0 gap-4 sm:grid-cols-2">
                  <label class="block min-w-0">
                    <span class="field-label">Wall texture</span>
                    <select id="wall-texture" class="field">
                      <option value="smooth">Smooth</option>
                      <option value="light">Light texture</option>
                      <option value="medium">Medium texture</option>
                      <option value="heavy">Heavy texture</option>
                    </select>
                  </label>
                  <label class="block min-w-0">
                    <span class="field-label">Ceiling texture</span>
                    <select id="ceiling-texture" class="field">
                      <option value="smooth">Smooth</option>
                      <option value="light">Light texture</option>
                      <option value="popcorn">Popcorn</option>
                    </select>
                  </label>
                  <label class="block min-w-0 sm:col-span-2">
                    <span class="field-label">Surface condition</span>
                    <select id="surface-condition" class="field">
                      <option value="good">Previously painted</option>
                      <option value="fair">Fair or patched</option>
                      <option value="new-drywall">New drywall</option>
                      <option value="stained">Stained</option>
                      <option value="glossy">Glossy</option>
                    </select>
                  </label>
                </div>

                <div class="border-t border-border pt-4">
                  <p class="text-sm font-semibold text-heading">Openings to deduct</p>
                  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
                    <label class="block">
                      <span class="field-label">Doors</span>
                      <input id="doors" type="number" min="0" step="1" class="field" />
                    </label>
                    <label class="block">
                      <span class="field-label">French doors</span>
                      <input id="french-doors" type="number" min="0" step="1" class="field" />
                    </label>
                    <label class="block">
                      <span class="field-label">Closet doors</span>
                      <input id="closet-doors" type="number" min="0" step="1" class="field" />
                    </label>
                    <label class="block">
                      <span class="field-label">Windows</span>
                      <input id="windows" type="number" min="0" step="1" class="field" />
                    </label>
                    <label class="block">
                      <span class="field-label">Large windows</span>
                      <input id="large-windows" type="number" min="0" step="1" class="field" />
                    </label>
                    <label class="block">
                      <span class="field-label">Small windows</span>
                      <input id="small-windows" type="number" min="0" step="1" class="field" />
                    </label>
                  </div>
                </div>

                <div class="border-t border-border pt-4">
                  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                    <label class="inline-flex min-h-11 items-center gap-3 text-sm font-medium text-heading">
                      <input id="include-waste" type="checkbox" class="h-5 w-5" />
                      Include waste buffer
                    </label>
                    <label class="inline-flex min-h-11 items-center gap-3 text-sm font-medium text-heading">
                      <input id="needs-primer" type="checkbox" class="h-5 w-5" />
                      Include primer
                    </label>
                  </div>

                  <div id="primer-panel" class="mt-3 grid gap-4 sm:grid-cols-2">
                    <label class="block">
                      <span class="field-label">Primer type</span>
                      <select id="primer-type" class="field">
                        <option value="standard">Standard</option>
                        <option value="high-hide">High hide</option>
                        <option value="pva">PVA drywall</option>
                      </select>
                    </label>
                    <label class="block">
                      <span class="field-label">Primer coats</span>
                      <select id="primer-coats" class="field">
                        <option value="1">1</option>
                        <option value="2">2</option>
                      </select>
                    </label>
                  </div>
                  <div id="trim-panel" class="mt-3 hidden">
                    <label class="block max-w-xs">
                      <span class="field-label">Trim height</span>
                      <select id="trim-height" class="field">
                        <option value="4">4 in</option>
                        <option value="6">6 in</option>
                        <option value="8">8 in</option>
                        <option value="10">10 in</option>
                        <option value="12">12 in</option>
                      </select>
                    </label>
                  </div>
                </div>
              </div>
            </details>
            <p id="form-error" class="callout hidden text-sm font-semibold text-heading md:col-span-2" role="alert"></p>
          </form>
        </section>
      </div>

      <aside class="min-w-0 space-y-8 lg:sticky lg:top-24 lg:self-start">
        <section id="shopping-list-section">
          <p class="text-[0.8125rem] text-muted print:hidden">Step 3</p>
          <h2 class="text-[1.75rem] md:text-[2rem]">Shopping list</h2>
          <div class="receipt mt-6">
            <span class="receipt-tape" aria-hidden="true"></span>
            <div class="receipt-head">
              <p class="receipt-title">Your paint run</p>
            </div>
            <hr class="receipt-rule" />
            <div id="container-plan"></div>
            <hr class="receipt-rule" />
            <div id="summary-cards"></div>
          </div>
        </section>

        <div class="planner-no-print">
          <p id="pro-cost-note" class="hire-line hidden mb-4"></p>
          <PainterQuoteCTA src="planner" heading="Big project? Get it quoted." body="Send the details to local painters and compare quotes." />
        </div>

        <section class="panel p-5 md:p-6">
          <p class="text-[0.8125rem] text-muted print:hidden">Room notes</p>
          <h2 class="text-[1.75rem] md:text-[2rem]">Per-room plan</h2>
          <div id="room-summary-list" class="mt-4 border-t border-border"></div>
        </section>

        <section class="planner-no-print callout">
          <p class="font-semibold text-heading">Why it helps</p>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm marker:text-accent">
            <li>Combine rooms before you buy so the total is not guesswork.</li>
            <li>Keep primer separate when the surface needs it.</li>
            <li>Share the plan with a contractor, partner, or store associate.</li>
            <li>Print a single sheet instead of juggling notes on the phone.</li>
          </ul>
        </section>
      </aside>
    </div>

    <div id="undo-room-bar" class="planner-no-print panel-ink fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-lg flex-col items-start justify-between gap-3 px-5 py-4 sm:flex-row sm:items-center" role="status" aria-live="polite">
      <span id="undo-room-message" class="text-sm font-medium"></span>
      <div class="flex shrink-0 items-center gap-2">
        <button id="confirm-room-removal-btn" type="button" class="btn btn-on-ink btn-sm">Keep removed</button>
        <button id="undo-room-btn" type="button" class="btn btn-primary btn-sm">Undo</button>
      </div>
    </div>

    <script type="application/json" id="planner-seed" set:html={JSON.stringify({
      project: initialProject,
      isSharedProject,
      shareToken: initialShareToken,
      summary: initialSummary,
    })} />

    <script>
      import {
        calculatePaint,
        estimateProCostTotal,
        proCostJob,
        roomRecommendations,
        type CalculationInputs,
      } from '../utils/paint-calculator';
      import { showProCostNote } from '../utils/pro-cost-note';
      import {
        createPaintRoom,
        createPaintProject,
        decodePaintProject,
        encodePaintProject,
        isPaintProject,
        normalizePaintProject,
        summarizePaintProject,
        type PaintProject,
      } from '../models/paint-project';

      const STORAGE_KEY = 'paintprocalc.paint-planner.project.v1';
      const seed = JSON.parse((document.getElementById('planner-seed') as HTMLScriptElement).textContent || '{}') as {
        project: PaintProject;
        isSharedProject: boolean;
        shareToken: string;
        summary: unknown;
      };

      const projectNameInput = document.getElementById('project-name') as HTMLInputElement;
      const printProjectTitle = document.getElementById('print-project-title') as HTMLElement;
      const roomList = document.getElementById('room-list') as HTMLElement;
      const roomSummaryList = document.getElementById('room-summary-list') as HTMLElement;
      const summaryCards = document.getElementById('summary-cards') as HTMLElement;
      const containerPlan = document.getElementById('container-plan') as HTMLElement;
      const roomCount = document.getElementById('room-count') as HTMLElement;
      const selectedRoomHint = document.getElementById('selected-room-hint') as HTMLElement;
      const selectedRoomResult = document.getElementById('selected-room-result') as HTMLElement;
      const mobileProjectTotal = document.getElementById('mobile-project-total') as HTMLElement;
      const proCostNote = document.getElementById('pro-cost-note');
      const saveStatus = document.getElementById('save-status') as HTMLElement;
      const addRoomBtn = document.getElementById('add-room-btn') as HTMLButtonElement;
      const copyLinkBtn = document.getElementById('copy-link-btn') as HTMLButtonElement;
      const downloadJsonBtn = document.getElementById('download-json-btn') as HTMLButtonElement;
      const openCopyBtn = document.getElementById('open-copy-btn') as HTMLButtonElement;
      const openCopyInput = document.getElementById('open-copy-input') as HTMLInputElement;
      const printBtn = document.getElementById('print-btn') as HTMLButtonElement;
      const newPlanBtn = document.getElementById('new-plan-btn') as HTMLButtonElement;
      const formError = document.getElementById('form-error') as HTMLElement;
      const roomEditorSection = document.getElementById('room-editor-section') as HTMLElement;
      const fineTuneDetails = document.getElementById('fine-tune-details') as HTMLDetailsElement;
      const undoRoomBar = document.getElementById('undo-room-bar') as HTMLElement;
      const undoRoomMessage = document.getElementById('undo-room-message') as HTMLElement;
      const undoRoomBtn = document.getElementById('undo-room-btn') as HTMLButtonElement;
      const confirmRoomRemovalBtn = document.getElementById('confirm-room-removal-btn') as HTMLButtonElement;
      const trimPanel = document.getElementById('trim-panel') as HTMLElement;
      const primerPanel = document.getElementById('primer-panel') as HTMLElement;
      const ceilingPaintPanel = document.getElementById('ceiling-paint-panel') as HTMLElement;

      const formFields = {
        name: document.getElementById('room-name') as HTMLInputElement,
        roomType: document.getElementById('room-type') as HTMLSelectElement,
        length: document.getElementById('length') as HTMLInputElement,
        width: document.getElementById('width') as HTMLInputElement,
        height: document.getElementById('height') as HTMLInputElement,
        surfaceType: document.getElementById('surface-type') as HTMLSelectElement,
        paintQuality: document.getElementById('paint-quality') as HTMLSelectElement,
        customCoverageRate: document.getElementById('custom-coverage-rate') as HTMLInputElement,
        numCoats: document.getElementById('num-coats') as HTMLSelectElement,
        wallTexture: document.getElementById('wall-texture') as HTMLSelectElement,
        ceilingTexture: document.getElementById('ceiling-texture') as HTMLSelectElement,
        surfaceCondition: document.getElementById('surface-condition') as HTMLSelectElement,
        doors: document.getElementById('doors') as HTMLInputElement,
        frenchDoors: document.getElementById('french-doors') as HTMLInputElement,
        closetDoors: document.getElementById('closet-doors') as HTMLInputElement,
        windows: document.getElementById('windows') as HTMLInputElement,
        largeWindows: document.getElementById('large-windows') as HTMLInputElement,
        smallWindows: document.getElementById('small-windows') as HTMLInputElement,
        includeWaste: document.getElementById('include-waste') as HTMLInputElement,
        needsPrimer: document.getElementById('needs-primer') as HTMLInputElement,
        primerType: document.getElementById('primer-type') as HTMLSelectElement,
        primerCoats: document.getElementById('primer-coats') as HTMLSelectElement,
        trimHeight: document.getElementById('trim-height') as HTMLSelectElement,
      };
      const paintFields = {
        name: document.getElementById('paint-name') as HTMLInputElement,
        sheen: document.getElementById('paint-sheen') as HTMLSelectElement,
        ceilingName: document.getElementById('ceiling-paint-name') as HTMLInputElement,
        ceilingSheen: document.getElementById('ceiling-paint-sheen') as HTMLSelectElement,
      };

      const sharedToken = new URL(window.location.href).searchParams.get('project');
      const sharedProject = sharedToken ? decodePaintProject(sharedToken) : null;
      const openedFromShare = Boolean(sharedProject);
      const startingProject = sharedProject ?? seed.project;
      const defaultProject = startingProject.rooms.length
        ? startingProject
        : {
            ...startingProject,
            rooms: [createPaintRoom('Room 1')],
          };

      let state: { project: PaintProject; selectedRoomId: string } = {
        project: defaultProject,
        selectedRoomId: defaultProject.rooms[0]?.id || '',
      };
      let lastRemoval: { room: PaintProject['rooms'][number]; index: number } | null = null;
      let undoTimer: number | undefined;

      type SaveStatusTone = 'neutral' | 'success' | 'warning' | 'error';

      function showSaveStatus(message: string, tone: SaveStatusTone = 'neutral') {
        // Plain text for routine messages; warnings and errors get the callout rule so they stand
        // out without a color of their own.
        const toneClasses: Record<SaveStatusTone, string> = {
          neutral: 'text-muted',
          success: 'font-medium text-heading',
          warning: 'callout px-4 py-3 font-medium text-heading',
          error: 'callout px-4 py-3 font-semibold text-heading',
        };
        saveStatus.className = `mt-4 text-sm ${toneClasses[tone]}`;
        saveStatus.textContent = message;
      }

      function round(value: number, digits = 1) {
        const factor = 10 ** digits;
        return Math.round(value * factor) / factor;
      }

      function getSelectedRoomIndex() {
        return state.project.rooms.findIndex((room) => room.id === state.selectedRoomId);
      }

      function getSelectedRoom() {
        return state.project.rooms[getSelectedRoomIndex()] || state.project.rooms[0];
      }

      function setProject(nextProject: PaintProject, selectedRoomId = state.selectedRoomId) {
        state = {
          project: nextProject,
          selectedRoomId: nextProject.rooms.some((room) => room.id === selectedRoomId)
            ? selectedRoomId
            : nextProject.rooms[0]?.id || '',
        };
        persistState();
        render();
      }

      function persistState() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state.project));
        const url = new URL(window.location.href);
        if (url.searchParams.has('project')) {
          url.searchParams.delete('project');
          window.history.replaceState({}, '', url);
        }
        showSaveStatus('Saved just now in this browser.');
      }

      function hideUndo() {
        undoRoomBar.classList.add('hidden');
        undoRoomBar.classList.remove('flex');
        if (undoTimer) window.clearTimeout(undoTimer);
        undoTimer = undefined;
      }

      function showUndo(roomName: string) {
        undoRoomMessage.textContent = `${roomName} was removed.`;
        undoRoomBar.classList.remove('hidden');
        undoRoomBar.classList.add('flex');
        if (undoTimer) window.clearTimeout(undoTimer);
        undoTimer = window.setTimeout(() => {
          lastRemoval = null;
          hideUndo();
        }, 8000);
      }

      function updateTimestamp() {
        state.project.updatedAt = new Date().toISOString();
      }

      function buildInputsFromRoom(roomInputs: CalculationInputs): CalculationInputs {
        const customCoverageRate = formFields.customCoverageRate.value.trim()
          ? Number(formFields.customCoverageRate.value)
          : undefined;

        return {
          ...roomInputs,
          length: Number(formFields.length.value) || 0,
          width: Number(formFields.width.value) || 0,
          height: Number(formFields.height.value) || 0,
          surfaceType: formFields.surfaceType.value as CalculationInputs['surfaceType'],
          roomType: formFields.roomType.value,
          paintQuality: formFields.paintQuality.value as CalculationInputs['paintQuality'],
          customCoverageRate: Number.isFinite(customCoverageRate as number) ? customCoverageRate : undefined,
          numCoats: Number(formFields.numCoats.value) || 1,
          wallTexture: formFields.wallTexture.value as CalculationInputs['wallTexture'],
          ceilingTexture: formFields.ceilingTexture.value as CalculationInputs['ceilingTexture'],
          surfaceCondition: formFields.surfaceCondition.value as CalculationInputs['surfaceCondition'],
          doors: Number(formFields.doors.value) || 0,
          frenchDoors: Number(formFields.frenchDoors.value) || 0,
          closetDoors: Number(formFields.closetDoors.value) || 0,
          windows: Number(formFields.windows.value) || 0,
          largeWindows: Number(formFields.largeWindows.value) || 0,
          smallWindows: Number(formFields.smallWindows.value) || 0,
          includeWaste: formFields.includeWaste.checked,
          needsPrimer: formFields.needsPrimer.checked,
          primerType: formFields.primerType.value as CalculationInputs['primerType'],
          primerCoats: Number(formFields.primerCoats.value) || 1,
          trimHeight: Number(formFields.trimHeight.value) || 6,
        };
      }

      function validateEditor() {
        const rules: Array<[HTMLInputElement, number, string]> = [
          [formFields.length, 1, 'Length must be at least 1 foot.'],
          [formFields.width, 1, 'Width must be at least 1 foot.'],
          [formFields.height, 6, 'Ceiling height must be at least 6 feet.'],
        ];
        for (const [field, minimum, message] of rules) {
          if (!field.value.trim() || !Number.isFinite(Number(field.value)) || Number(field.value) < minimum) {
            formError.textContent = message;
            formError.classList.remove('hidden');
            return false;
          }
        }
        const countFields: Array<[HTMLInputElement, string]> = [
          [formFields.doors, 'Doors'],
          [formFields.frenchDoors, 'French doors'],
          [formFields.closetDoors, 'Closet doors'],
          [formFields.windows, 'Windows'],
          [formFields.largeWindows, 'Large windows'],
          [formFields.smallWindows, 'Small windows'],
        ];
        for (const [field, label] of countFields) {
          const value = Number(field.value);
          if (!Number.isInteger(value) || value < 0) {
            formError.textContent = `${label} must be a whole number of zero or more.`;
            formError.classList.remove('hidden');
            return false;
          }
        }
        const coverage = formFields.customCoverageRate.value.trim();
        if (coverage && (!Number.isFinite(Number(coverage)) || Number(coverage) <= 0)) {
          formError.textContent = 'Coverage must be greater than zero.';
          formError.classList.remove('hidden');
          return false;
        }
        formError.textContent = '';
        formError.classList.add('hidden');
        return true;
      }

      function escapeHtml(value: string) {
        return value.replace(/[&<>'"]/g, (character) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;',
        })[character] || character);
      }

      function syncSelectedRoomResult(room = getSelectedRoom()) {
        if (!room) return;
        const estimate = calculatePaint(room.inputs);
        const totalPaintableArea = estimate.paintableArea + estimate.ceilingPaintableArea;
        selectedRoomResult.classList.toggle('font-semibold', totalPaintableArea === 0);
        if (totalPaintableArea === 0) {
          selectedRoomResult.textContent = `${room.name}: no paintable area remains after deductions. Check the room dimensions and opening counts.`;
          return;
        }
        const primerNote = estimate.primerGallonsExact > 0
          ? ` Primer adds about ${estimate.primerGallonsExact.toFixed(1)} gallons.`
          : '';
        if (room.inputs.surfaceType === 'walls-ceiling') {
          const walls = calculatePaint({ ...room.inputs, surfaceType: 'walls' }).estimateRange.likely.gallonsWithWaste;
          const ceiling = calculatePaint({ ...room.inputs, surfaceType: 'ceiling' }).estimateRange.likely.gallonsWithWaste;
          selectedRoomResult.textContent = `${room.name}: about ${walls.toFixed(1)} gallons for walls and ${ceiling.toFixed(1)} gallons for the ceiling.${primerNote}`;
          return;
        }
        selectedRoomResult.textContent = `${room.name}: about ${estimate.estimateRange.likely.gallonsWithWaste.toFixed(1)} gallons of finish paint before rounding to can sizes.${primerNote}`;
      }

      function scrollToRoomEditor() {
        if (!window.matchMedia('(max-width: 1023px)').matches) return;
        const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        requestAnimationFrame(() => roomEditorSection.scrollIntoView({ behavior, block: 'start' }));
      }

      function syncEditor(room = getSelectedRoom()) {
        if (!room) {
          return;
        }

        const inputs = room.inputs;
        projectNameInput.value = state.project.name;
        printProjectTitle.textContent = state.project.name;
        formFields.name.value = room.name;
        paintFields.name.value = room.paint.name;
        paintFields.sheen.value = room.paint.sheen;
        paintFields.ceilingName.value = room.ceilingPaint.name;
        paintFields.ceilingSheen.value = room.ceilingPaint.sheen;
        formFields.roomType.value = inputs.roomType;
        formFields.length.value = String(inputs.length);
        formFields.width.value = String(inputs.width);
        formFields.height.value = String(inputs.height);
        formFields.surfaceType.value = inputs.surfaceType;
        formFields.paintQuality.value = inputs.paintQuality;
        formFields.customCoverageRate.value = inputs.customCoverageRate ? String(inputs.customCoverageRate) : '';
        formFields.numCoats.value = String(inputs.numCoats);
        formFields.wallTexture.value = inputs.wallTexture;
        formFields.ceilingTexture.value = inputs.ceilingTexture;
        formFields.surfaceCondition.value = inputs.surfaceCondition;
        formFields.doors.value = String(inputs.doors);
        formFields.frenchDoors.value = String(inputs.frenchDoors);
        formFields.closetDoors.value = String(inputs.closetDoors);
        formFields.windows.value = String(inputs.windows);
        formFields.largeWindows.value = String(inputs.largeWindows);
        formFields.smallWindows.value = String(inputs.smallWindows);
        formFields.includeWaste.checked = inputs.includeWaste;
        formFields.needsPrimer.checked = inputs.needsPrimer;
        formFields.primerType.value = inputs.primerType || 'standard';
        formFields.primerCoats.value = String(inputs.primerCoats || 1);
        formFields.trimHeight.value = String(inputs.trimHeight || 6);
        primerPanel.classList.toggle('hidden', !inputs.needsPrimer);
        trimPanel.classList.toggle('hidden', inputs.surfaceType !== 'trim');
        ceilingPaintPanel.classList.toggle('hidden', inputs.surfaceType !== 'walls-ceiling');
        fineTuneDetails.open = Boolean(
          inputs.needsPrimer
          || inputs.customCoverageRate
          || inputs.paintQuality !== 'standard'
          || inputs.numCoats !== 2
          || inputs.wallTexture !== 'smooth'
          || inputs.ceilingTexture !== 'smooth'
          || inputs.surfaceCondition !== 'good'
          || inputs.surfaceType === 'trim'
        );
        selectedRoomHint.textContent = `${inputs.surfaceType.replace('-', ' ')}, ${inputs.paintQuality} paint`;
        syncSelectedRoomResult(room);
      }

      function updateRoomFromEditor() {
        const index = getSelectedRoomIndex();
        if (index === -1) return;
        if (!validateEditor()) return;

        const room = state.project.rooms[index];
        const updatedRoom = {
          ...room,
          name: formFields.name.value.trim() || room.name,
          inputs: buildInputsFromRoom(room.inputs),
          paint: {
            name: paintFields.name.value.trim() || `${formFields.name.value.trim() || room.name} finish paint`,
            sheen: paintFields.sheen.value,
          },
          ceilingPaint: {
            name: paintFields.ceilingName.value.trim() || `${formFields.name.value.trim() || room.name} ceiling paint`,
            sheen: paintFields.ceilingSheen.value,
          },
          estimate: undefined,
        };

        const rooms = state.project.rooms.slice();
        rooms[index] = updatedRoom;
        updateTimestamp();
        state.project = { ...state.project, name: projectNameInput.value.trim() || state.project.name, rooms };
        persistState();
        syncSelectedRoomResult(updatedRoom);
        render(false);
      }

      function addRoom() {
        const nextRoomNumber = state.project.rooms.length + 1;
        const nextRoom = createPaintRoom(`Room ${nextRoomNumber}`);
        const project = {
          ...state.project,
          rooms: [...state.project.rooms, nextRoom],
          updatedAt: new Date().toISOString(),
        };
        state.project = project;
        state.selectedRoomId = nextRoom.id;
        persistState();
        render();
        scrollToRoomEditor();
      }

      function startNewPlan() {
        if (!window.confirm('Start a new plan? This replaces the plan currently saved in this browser.')) return;
        const project = createPaintProject('Whole-home paint plan');
        const room = createPaintRoom('Room 1');
        project.rooms.push(room);
        lastRemoval = null;
        hideUndo();
        setProject(project, room.id);
        showSaveStatus('New plan started and saved in this browser.');
        projectNameInput.focus();
        projectNameInput.select();
      }

      function duplicateRoom(roomId: string) {
        const source = state.project.rooms.find((room) => room.id === roomId);
        if (!source) return;
        const duplicate = {
          ...source,
          id: crypto.randomUUID(),
          name: `${source.name} copy`,
        };
        const project = {
          ...state.project,
          rooms: [...state.project.rooms, duplicate],
          updatedAt: new Date().toISOString(),
        };
        state.project = project;
        state.selectedRoomId = duplicate.id;
        persistState();
        render();
        scrollToRoomEditor();
      }

      function removeRoom(roomId: string) {
        if (state.project.rooms.length === 1) return;
        const removedIndex = state.project.rooms.findIndex((room) => room.id === roomId);
        const removedRoom = state.project.rooms[removedIndex];
        if (!removedRoom) return;
        lastRemoval = { room: removedRoom, index: removedIndex };
        const rooms = state.project.rooms.filter((room) => room.id !== roomId);
        const project = { ...state.project, rooms, updatedAt: new Date().toISOString() };
        state.project = project;
        state.selectedRoomId = state.selectedRoomId === roomId
          ? rooms[Math.min(removedIndex, rooms.length - 1)]?.id || ''
          : state.selectedRoomId;
        persistState();
        render();
        showUndo(removedRoom.name);
      }

      function undoRoomRemoval() {
        if (!lastRemoval) return;
        const rooms = state.project.rooms.slice();
        rooms.splice(Math.min(lastRemoval.index, rooms.length), 0, lastRemoval.room);
        state.project = { ...state.project, rooms, updatedAt: new Date().toISOString() };
        state.selectedRoomId = lastRemoval.room.id;
        lastRemoval = null;
        persistState();
        render();
        hideUndo();
        scrollToRoomEditor();
      }

      function confirmRoomRemoval() {
        lastRemoval = null;
        hideUndo();
        showSaveStatus('Room removed. Your plan is saved in this browser.');
      }

      function setSelectedRoom(roomId: string) {
        state.selectedRoomId = roomId;
        syncEditor(getSelectedRoom());
        renderRoomList();
        renderRoomSummary();
        scrollToRoomEditor();
      }

      function planContainers(needed: number) {
        const target = Math.max(0, needed);
        if (target === 0) {
          return { fiveGallon: 0, oneGallon: 0, total: 0, excess: 0 };
        }

        let best = { fiveGallon: 0, oneGallon: Math.ceil(target), total: Math.ceil(target), excess: Math.ceil(target) - target };

        for (let five = 0; five <= Math.ceil(target / 5) + 1; five += 1) {
          for (let one = 0; one <= 4; one += 1) {
            const total = five * 5 + one;
            if (total < target) continue;
            const excess = round(total - target, 2);
            const containers = five + one;
            const bestContainers = best.fiveGallon + best.oneGallon;
            if (excess < best.excess || (excess === best.excess && containers < bestContainers)) {
              best = { fiveGallon: five, oneGallon: one, total, excess };
            }
          }
        }

        return best;
      }

      function roomFinishPurchaseGallons(room: PaintProject['rooms'][number]) {
        if (room.inputs.surfaceType !== 'walls-ceiling') {
          return calculatePaint(room.inputs).estimateRange.likely.purchaseGallons;
        }
        const walls = calculatePaint({ ...room.inputs, surfaceType: 'walls' }).estimateRange.likely.purchaseGallons;
        const ceiling = calculatePaint({ ...room.inputs, surfaceType: 'ceiling' }).estimateRange.likely.purchaseGallons;
        return walls + ceiling;
      }

      function renderRoomList() {
        roomCount.textContent = `${state.project.rooms.length} room${state.project.rooms.length === 1 ? '' : 's'}`;
        const onlyRoom = state.project.rooms.length === 1;
        roomList.replaceChildren(...state.project.rooms.map((room) => {
          const selected = room.id === state.selectedRoomId;
          const article = document.createElement('article');
          // A ruled list: hairline between rows, a quiet fill on the room being edited.
          article.className = `cursor-pointer border-t border-border px-5 py-4 transition-[background-color] md:px-6 ${selected ? 'bg-light-gray' : 'hover:bg-light-gray/50'}`;
          article.dataset.roomId = room.id;
          article.setAttribute('aria-current', selected ? 'true' : 'false');
          const safeRoomId = escapeHtml(room.id);
          const safeRoomName = escapeHtml(room.name);
          const safeRoomType = escapeHtml(room.inputs.roomType.replace('-', ' '));
          const safePaintName = escapeHtml(room.paint.name);
          article.innerHTML = `
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="break-words text-[1.125rem] text-heading">${safeRoomName}</h3>
                <p class="mt-0.5 text-sm first-letter:uppercase">${safeRoomType}, ${room.inputs.length} × ${room.inputs.width} ft</p>
                <p class="mt-0.5 break-words text-[0.8125rem] text-muted">${safePaintName}, ${escapeHtml(room.paint.sheen)}</p>
              </div>
              <p class="numeral shrink-0 text-[1.625rem] text-heading">${roomFinishPurchaseGallons(room)}<span class="font-sans text-sm text-muted"> gal</span></p>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <button type="button" data-action="select" data-room-id="${safeRoomId}" class="btn btn-secondary btn-sm ${selected ? 'bg-heading text-secondary' : ''}">${selected ? 'Editing' : 'Edit'}</button>
              <button type="button" data-action="duplicate" data-room-id="${safeRoomId}" class="btn btn-ghost btn-sm">Duplicate</button>
              <button type="button" data-action="remove" data-room-id="${safeRoomId}" ${onlyRoom ? 'disabled aria-disabled="true"' : ''} class="btn btn-ghost btn-sm">Remove</button>
            </div>
          `;
          return article;
        }));
      }

      function renderSummary() {
        const summary = summarizePaintProject(state.project);
        const finishPurchaseTotal = summary.finishGroups.reduce((total, group) => total + group.purchaseGallons, 0);
        const primerPurchaseTotal = summary.primerGroups.reduce((total, group) => total + group.purchaseGallons, 0);
        mobileProjectTotal.textContent = primerPurchaseTotal > 0
          ? `Project: ${finishPurchaseTotal} gal finish, ${primerPurchaseTotal} gal primer`
          : `Project: ${finishPurchaseTotal} gal finish paint`;
        // Project totals, drawn as the lower half of the receipt.
        const totalsRule = document.createElement('hr');
        totalsRule.className = 'receipt-rule';
        summaryCards.replaceChildren(
          detailRow('Rooms', String(summary.roomCount)),
          detailRow('Area', `${summary.totalPaintableArea} sq ft`),
          totalsRule,
          totalRow('Finish paint', `${finishPurchaseTotal} gal`),
          totalRow('Primer', `${primerPurchaseTotal} gal`, primerPurchaseTotal === 0),
        );

        const rows = [
          ...summary.finishGroups.map((group) => planRow(
            group.name,
            `${group.sheen}, ${group.quality}`,
            group,
            `${group.surfaces.join(' and ')} for ${formatRoomNames(group.roomNames)}`,
          )),
          ...summary.primerGroups.map((group) => planRow(
            group.name,
            '',
            group,
            `Primer for ${formatRoomNames(group.roomNames)}`,
          )),
        ];
        containerPlan.replaceChildren(...rows);

        // Hiring-a-painter range for the whole project: every room's low and high are added up
        // first, then rounded and held to the job minimums once. Trim-only rooms add nothing.
        showProCostNote(
          proCostNote,
          estimateProCostTotal(summary.rooms.flatMap((room) => proCostJob(room.inputs, room.estimate) ?? [])),
          'project',
        );
      }

      function formatRoomNames(names: string[]) {
        const counts = new Map<string, number>();
        names.forEach((name) => counts.set(name, (counts.get(name) || 0) + 1));
        return Array.from(counts.entries())
          .map(([name, count]) => count > 1 ? `${name} (${count})` : name)
          .join(', ');
      }

      function renderRoomSummary() {
        const summary = summarizePaintProject(state.project);
        roomSummaryList.replaceChildren(...summary.rooms.map((room) => {
          const note = roomRecommendations[room.inputs.roomType] || 'No room-specific note available.';
          const estimate = room.estimate.estimateRange.likely;
          const roomPurchaseGallons = roomFinishPurchaseGallons(room);
          const item = document.createElement('article');
          item.className = 'border-b border-border py-4 last:border-b-0 last:pb-0';
          const safeRoomName = escapeHtml(room.name);
          const safeSurface = escapeHtml(room.inputs.surfaceType.replace('-', ' '));
          const safeNote = escapeHtml(note);
          item.innerHTML = `
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h3 class="break-words text-[1.125rem] text-heading">${safeRoomName}</h3>
                <p class="mt-0.5 text-sm first-letter:uppercase">${safeSurface}, ${room.inputs.numCoats} coat${room.inputs.numCoats === 1 ? '' : 's'}</p>
              </div>
              <p class="numeral shrink-0 text-right text-[1.375rem] text-heading">${roomPurchaseGallons}<span class="font-sans text-sm text-muted"> gal total</span></p>
            </div>
            <p class="mt-3 text-sm">${safeNote}</p>
            <p class="mt-2 text-sm text-heading">Estimated use: ${estimate.gallonsWithWaste.toFixed(1)} gal. Practical range: ${room.estimate.estimateRange.low.gallonsWithWaste.toFixed(1)} to ${room.estimate.estimateRange.high.gallonsWithWaste.toFixed(1)} gal.</p>
          `;
          return item;
        }));
      }

      // A plain line on the receipt, such as the room count.
      function detailRow(label: string, value: string) {
        const element = document.createElement('div');
        element.className = 'receipt-row';
        element.innerHTML = `<span>${label}</span><span>${value}</span>`;
        return element;
      }

      // A total on the receipt: the label and the figure in the serif numeral size.
      function totalRow(label: string, value: string, quiet = false) {
        const element = document.createElement('div');
        element.className = `receipt-total mt-1 ${quiet ? 'text-muted' : ''}`;
        element.innerHTML = `<span>${label}</span><span class="receipt-total-value">${value}</span>`;
        return element;
      }

      // One product on the receipt: name and gallons to buy on the first line, the details under it.
      function planRow(label: string, descriptor: string, summary: { lowGallons: number; likelyGallons: number; highGallons: number; purchaseGallons: number }, note: string) {
        const item = document.createElement('div');
        const plan = planContainers(summary.likelyGallons);
        const safeLabel = escapeHtml(label);
        const safeDescriptor = escapeHtml(descriptor);
        const safeNote = escapeHtml(note);
        const buyText = plan.total > 0
          ? `Buy ${plan.fiveGallon ? `${plan.fiveGallon} five-gallon bucket${plan.fiveGallon === 1 ? '' : 's'}` : ''}${plan.fiveGallon && plan.oneGallon ? ' and ' : ''}${plan.oneGallon ? `${plan.oneGallon} one-gallon can${plan.oneGallon === 1 ? '' : 's'}` : ''}`
          : 'No paint to buy. Check room measurements and openings.';
        item.className = 'mt-5 first:mt-0';
        item.innerHTML = `
          <div class="receipt-row">
            <span class="min-w-0 [overflow-wrap:anywhere]">${safeLabel}</span>
            <span>${summary.purchaseGallons} gal</span>
          </div>
          ${descriptor ? `<p class="text-[0.8125rem] leading-snug text-muted first-letter:uppercase">${safeDescriptor}</p>` : ''}
          <p class="text-[0.8125rem] leading-snug text-muted">${safeNote}</p>
          <p class="text-[0.8125rem] leading-snug text-muted">Estimated use: ${summary.likelyGallons.toFixed(1)} gal</p>
          <p class="mt-1.5 font-medium">${buyText}</p>
        `;
        return item;
      }

      function render(syncForm = true) {
        renderRoomList();
        renderSummary();
        renderRoomSummary();
        if (syncForm) syncEditor(getSelectedRoom());
      }

      async function copyShareLink() {
        const token = encodePaintProject(state.project);
        const url = new URL(window.location.href);
        url.searchParams.set('project', token);
        if (url.toString().length > 7000) {
          showSaveStatus('This plan is too large for a dependable link. Download a backup instead.', 'warning');
          return false;
        }
        await navigator.clipboard.writeText(url.toString());
        return true;
      }

      projectNameInput.value = state.project.name;
      syncEditor(getSelectedRoom());
      render();

      addRoomBtn.addEventListener('click', addRoom);
      copyLinkBtn.addEventListener('click', async () => {
        try {
          const copied = await copyShareLink();
          if (copied) showSaveStatus('Plan link copied to your clipboard.', 'success');
        } catch {
          const token = encodePaintProject(state.project);
          const url = new URL(window.location.href);
          url.searchParams.set('project', token);
          window.prompt('Copy this share link', url.toString());
        }
      });

      downloadJsonBtn.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(state.project, null, 2)], { type: 'application/json' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        const safeName = state.project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'paint-plan';
        link.download = `${safeName}.paint-plan.json`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        showSaveStatus('Backup downloaded. Keep the file so you can restore this plan later.', 'success');
      });

      openCopyBtn.addEventListener('click', () => {
        showSaveStatus('Choose a paint plan backup from your device. Your current plan will not change until you confirm.');
        openCopyInput.click();
      });
      openCopyInput.addEventListener('change', async () => {
        const file = openCopyInput.files?.[0];
        if (!file) return;
        try {
          const raw = JSON.parse(await file.text()) as unknown;
          if (!isPaintProject(raw)) throw new Error('Invalid paint plan');
          const project = normalizePaintProject(raw);
          if (!project.rooms.length) project.rooms = [createPaintRoom('Room 1')];
          const roomLabel = `${project.rooms.length} ${project.rooms.length === 1 ? 'room' : 'rooms'}`;
          const shouldRestore = window.confirm(`Restore "${project.name}" with ${roomLabel}? This will replace the plan currently saved in this browser.`);
          if (!shouldRestore) {
            showSaveStatus('Restore canceled. Your current plan was not changed.');
            return;
          }
          setProject(project, project.rooms[0].id);
          showSaveStatus(`Backup restored: "${project.name}" with ${roomLabel}. It is now saved in this browser.`, 'success');
          saveStatus.focus();
        } catch {
          showSaveStatus('That file could not be restored. Choose a backup downloaded from this paint planner.', 'error');
          saveStatus.focus();
        } finally {
          openCopyInput.value = '';
        }
      });

      printBtn.addEventListener('click', () => window.print());
      newPlanBtn.addEventListener('click', startNewPlan);
      undoRoomBtn.addEventListener('click', undoRoomRemoval);
      confirmRoomRemovalBtn.addEventListener('click', confirmRoomRemoval);

      projectNameInput.addEventListener('input', () => {
        state.project.name = projectNameInput.value.trim() || 'Whole-home paint plan';
        printProjectTitle.textContent = state.project.name;
        updateTimestamp();
        persistState();
      });

      roomList.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest('button[data-action]') as HTMLButtonElement | null;
        const roomCard = target.closest('article[data-room-id]') as HTMLElement | null;
        const roomId = button?.dataset.roomId || roomCard?.dataset.roomId;
        if (!roomId) return;

        if (!button) {
          setSelectedRoom(roomId);
          return;
        }

        if (button.dataset.action === 'select') {
          setSelectedRoom(roomId);
        }
        if (button.dataset.action === 'duplicate') {
          duplicateRoom(roomId);
        }
        if (button.dataset.action === 'remove') {
          removeRoom(roomId);
        }
      });

      Object.values(formFields).forEach((field) => {
        const eventName = field instanceof HTMLInputElement && field.type === 'text' ? 'input' : 'change';
        field.addEventListener(eventName, () => {
          updateRoomFromEditor();
          trimPanel.classList.toggle('hidden', formFields.surfaceType.value !== 'trim');
          primerPanel.classList.toggle('hidden', !formFields.needsPrimer.checked);
          ceilingPaintPanel.classList.toggle('hidden', formFields.surfaceType.value !== 'walls-ceiling');
        });
      });

      Object.values(paintFields).forEach((field) => {
        const eventName = field instanceof HTMLInputElement ? 'input' : 'change';
        field.addEventListener(eventName, updateRoomFromEditor);
      });

      window.addEventListener('storage', (event) => {
        if (event.key !== STORAGE_KEY || !event.newValue) return;
        try {
          const parsed = normalizePaintProject(JSON.parse(event.newValue) as PaintProject);
          state.project = parsed.rooms.length ? parsed : { ...parsed, rooms: [createPaintRoom('Room 1')] };
          state.selectedRoomId = state.project.rooms[0]?.id || '';
          render();
        } catch {
          // Ignore malformed storage updates.
        }
      });

      const stored = localStorage.getItem(STORAGE_KEY);
      if (!openedFromShare && stored) {
        try {
          const parsed = normalizePaintProject(JSON.parse(stored) as PaintProject);
          state.project = parsed.rooms.length ? parsed : { ...parsed, rooms: [createPaintRoom('Room 1')] };
          state.selectedRoomId = state.project.rooms[0]?.id || '';
          render();
        } catch {
          // Fall back to the seeded project.
          showSaveStatus('The saved browser plan could not be opened. A fresh plan is shown instead.', 'warning');
        }
      } else if (openedFromShare) {
        showSaveStatus('Shared plan opened. Any changes you make will be saved in this browser.', 'success');
      } else {
        persistState();
      }

      if (sharedToken && !sharedProject) {
        showSaveStatus('That plan link could not be opened. Your saved browser plan is shown instead.', 'warning');
      }
    </script>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* The planner draws its room rows and receipt lines in the browser, so these rules are global,
     scoped under .planner-page. */

  @media print {
    /* The printed sheet is plain, so the receipt drops its tape strip. */
    .planner-page .receipt-tape {
      display: none;
    }
  }
</style>
