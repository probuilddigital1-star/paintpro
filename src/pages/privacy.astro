---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const updatedDate = '2026-07-11';
const lastUpdated = "July 11, 2026";
const siteUrl = "https://paintprocalculator.com";

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Privacy Policy",
      "item": `${siteUrl}/privacy`
    }
  ]
};

// Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Privacy Policy - PaintPro Calculator",
  "description": "Privacy policy for PaintPro Calculator. Learn how we collect, use, and protect your information when using our free paint coverage calculator.",
  "url": `${siteUrl}/privacy`,
  "datePublished": "2025-12-26",
  "dateModified": updatedDate,
  "author": {
    "@type": "Organization",
    "name": "ProBuild Digital LLC",
    "url": "https://probuilddigital.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ProBuild Digital LLC"
  },
  "inLanguage": "en-US"
};
---

<Layout
  title="Privacy Policy - Paint Calculator | PaintPro Calculator"
  description="Privacy policy for PaintPro Calculator. Learn how we collect, use, and protect your information when using our free paint coverage calculator."
>
  <Header />

  <!-- Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main class="mx-auto max-w-xl px-4 pt-8 pb-16 md:pt-14 md:pb-24">
    <article>
      <h1 class="mb-4 text-[2.5rem] md:text-[3.75rem]">Privacy Policy</h1>
      <p class="mb-8 text-sm text-muted">Last updated: {lastUpdated}</p>

      <div class="prose-linen [&>h2]:mt-12 [&>h2]:border-t [&>h2]:border-border [&>h2]:pt-7 md:[&>h2]:mt-14 md:[&>h2]:pt-8 [&>h2:first-child]:mt-0">
        <h2>Introduction</h2>
        <p>
          ProBuild Digital LLC ("we," "us," or "our") operates PaintPro Calculator (paintprocalculator.com). This Privacy Policy explains how we collect, use, and protect information when you use our paint calculator tool.
        </p>

        <h2>Information We Collect</h2>

        <h3>Calculator Usage</h3>
        <p>
          The paint calculator runs entirely in your browser. Room dimensions and other inputs you enter are not sent to our servers or stored anywhere.
        </p>

        <h3>Lead Generation Form</h3>
        <p>
          If you choose to request quotes from local painters, we collect:
        </p>
        <ul>
          <li>Zip code</li>
          <li>Project type</li>
          <li>Email address</li>
        </ul>
        <p>
          This information is shared with our lead generation partners to connect you with local painting professionals.
        </p>

        <h3>Analytics</h3>
        <p>
          We use privacy-friendly analytics to understand how visitors use our site. This may include general information like page views, browser type, and approximate location (country/region level).
        </p>

        <h2>How We Use Information</h2>
        <ul>
          <li>To provide the paint calculator service</li>
          <li>To connect you with painting professionals (if you request quotes)</li>
          <li>To improve our website and user experience</li>
          <li>To respond to your inquiries</li>
        </ul>

        <h2>Affiliate Links</h2>
        <p>
          Our site includes affiliate links to Amazon and other retailers. When you click these links, those sites may use cookies to track that the referral came from our site. Please review their respective privacy policies.
        </p>

        <h2>Cookies</h2>
        <p>
          We use minimal cookies necessary for the site to function. Third-party services (like analytics or affiliate programs) may set their own cookies. You can manage cookie preferences in your browser settings.
        </p>

        <h2>Third-Party Services</h2>
        <p>
          We use the following third-party services that may process your data:
        </p>
        <ul>
          <li>Google Analytics (website analytics) - only with your consent</li>
          <li>Cloudflare (hosting and security)</li>
          <li>n8n (email list automation)</li>
          <li>Amazon Associates (affiliate program)</li>
        </ul>
        <p>
          These services may process data in the United States. By using our site and providing consent, you acknowledge this transfer.
        </p>

        <h2>Data Security</h2>
        <p>
          We implement appropriate security measures to protect any information we collect. Our site uses HTTPS encryption for all connections.
        </p>

        <h2>Your Rights</h2>
        <p>
          You have the right to:
        </p>
        <ul>
          <li>Access your personal data</li>
          <li>Request correction of inaccurate data</li>
          <li>Request deletion of your data</li>
          <li>Withdraw consent at any time</li>
        </ul>
        <p>
          To exercise these rights, email us at <a href="mailto:contact@probuilddigital.com">contact@probuilddigital.com</a>. We will respond within 30 days.
        </p>

        <h2>Data Retention</h2>
        <p>
          Email list subscribers: We retain your email until you unsubscribe. Analytics data: Retained for 14 months (Google Analytics default). You can request deletion at any time.
        </p>

        <h2>Children's Privacy</h2>
        <p>
          Our service is not directed at children under 13. We do not knowingly collect personal information from children.
        </p>

        <h2>Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy periodically. We'll post any changes on this page with an updated revision date.
        </p>

        <h2>Contact Us</h2>
        <p>
          If you have questions about this Privacy Policy, contact us at:
        </p>
        <p class="mt-2">
          Email: <a href="mailto:contact@probuilddigital.com">contact@probuilddigital.com</a>
        </p>
        <p class="mt-2">
          ProBuild Digital LLC
        </p>
      </div>

      <div class="mt-12 border-t border-border pt-6">
        <a href="/" class="link">Back to Calculator</a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
